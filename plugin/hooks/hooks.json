{
  "description": "Ghost lifecycle wiring: inject project memory at session start, deliver a floored memory block beside a message or an edit when one matches, and nudge a save (plus run consolidation) when the session goes idle.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/ghost-launcher",
            "args": [
              "hook",
              "session-start",
              "--source",
              "claude-code"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/ghost-launcher",
            "args": [
              "hook",
              "stop",
              "--source",
              "claude-code"
            ]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/ghost-launcher",
            "args": [
              "hook",
              "message-submit",
              "--source",
              "claude-code"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/ghost-launcher",
            "args": [
              "hook",
              "edit",
              "--source",
              "claude-code"
            ]
          }
        ]
      }
    ]
  }
}
