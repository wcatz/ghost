# Ghost retrieval benchmark dataset v2. Domain: Cardano stake-pool infra,
# Ghost internals, SRE/security/Go engineering (paraphrase-heavy queries).
# Keys are stable; embeddings.json is keyed by these keys (and by query names
# in queries.jsonl). Regenerate embeddings via Ollama POST /api/embed
# (nomic-embed-text:v1.5, 768 dims) when this file changes. See docs/benchmarks.md.
{"key":"node_port","category":"fact","content":"The mainnet cardano-node listens for peer connections on TCP port 3001.","importance":0.7,"tags":["cardano","node","network"]}
{"key":"relay_topology","category":"architecture","content":"Relay nodes connect to the block producer over a private topology; the block producer only peers with our own relays, never public peers.","importance":0.8,"tags":["cardano","topology","relay"]}
{"key":"kes_rotation","category":"gotcha","content":"KES keys expire every 90 days on mainnet; rotate the operational certificate before the KES period lapses or the block producer stops forging blocks.","importance":0.9,"tags":["cardano","kes","keys"]}
{"key":"ogmios_port","category":"fact","content":"Ogmios exposes its WebSocket JSON-RPC bridge to cardano-node on port 1337.","importance":0.6,"tags":["cardano","ogmios","network"]}
{"key":"db_sync_pg","category":"dependency","content":"cardano-db-sync requires PostgreSQL 14 or newer and writes the full chain history into the cexplorer database.","importance":0.7,"tags":["cardano","db-sync","postgres"]}
{"key":"pledge","category":"convention","content":"Keep the pool pledge fully funded in the registered reward address; an unmet pledge zeroes out pool rewards for that epoch.","importance":0.8,"tags":["cardano","pledge","rewards"]}
{"key":"helmfile_diff","category":"convention","content":"Always run helmfile diff before helmfile apply so infrastructure changes are reviewed before they hit the production cluster.","importance":0.9,"tags":["infra","helmfile","workflow"]}
{"key":"sops_age","category":"fact","content":"Secrets in the infra repo are encrypted with SOPS using an Age key; never commit an unencrypted secret.","importance":0.9,"tags":["infra","sops","secrets"]}
{"key":"k3s_tailscale","category":"architecture","content":"The K3s cluster uses native Tailscale VPN auth mode so nodes join over the tailnet rather than a public network.","importance":0.7,"tags":["infra","k3s","tailscale"]}
{"key":"arc_runners","category":"architecture","content":"CI runs on self-hosted GitHub Actions Runner Controller (ARC) pods inside the K3s cluster, not on GitHub-hosted runners.","importance":0.6,"tags":["infra","ci","arc"]}
{"key":"no_main_push","category":"preference","content":"Never push directly to main; every change goes through a feature branch and a pull request, no matter how small.","importance":1.0,"tags":["workflow","git","policy"]}
{"key":"yaml_indent","category":"convention","content":"YAML files use two-space indentation everywhere; never change the indentation width.","importance":0.6,"tags":["convention","yaml","style"]}
{"key":"ghost_hybrid","category":"architecture","content":"Ghost hybrid search fuses FTS5 and vector results with reciprocal rank fusion, weighting the vector leg 70 percent and the full-text leg 30 percent.","importance":0.8,"tags":["ghost","search","rrf"]}
{"key":"ghost_decay","category":"pattern","content":"Ghost time-decay scoring never decays preference, convention, or fact memories, while gotchas and decisions fade on a 30-day scale.","importance":0.7,"tags":["ghost","decay","scoring"]}
{"key":"ghost_sqlite","category":"dependency","content":"Ghost stores everything in a single SQLite database using the pure-Go modernc driver, so builds need no CGO and no C toolchain.","importance":0.8,"tags":["ghost","sqlite","go"]}
{"key":"ghost_reflect","category":"pattern","content":"Ghost reflection is dry-run by default; you must pass --apply to actually consolidate a project's memories, and --restore undoes the last run from a snapshot.","importance":0.7,"tags":["ghost","reflection","cli"]}
{"key":"ghost_ollama","category":"dependency","content":"Ghost computes embeddings locally with Ollama running nomic-embed-text; without Ollama it degrades gracefully to full-text-only search.","importance":0.7,"tags":["ghost","ollama","embeddings"]}
{"key":"ghost_global","category":"convention","content":"Ghost injects memories from the _global project into every project's session context, so cross-cutting rules are always visible.","importance":0.6,"tags":["ghost","global","context"]}
{"key":"grafana_port","category":"fact","content":"The Grafana dashboard on the monitoring host is served on port 80 behind the ingress.","importance":0.5,"tags":["infra","grafana","monitoring"]}
{"key":"prom_stack","category":"architecture","content":"Cluster monitoring uses the kube-prometheus-stack Helm chart for Prometheus, Alertmanager, and Grafana.","importance":0.6,"tags":["infra","prometheus","monitoring"]}
{"key":"decision_sqlite","category":"decision","content":"Chose SQLite over Postgres for Ghost's store so the whole system ships as one zero-infrastructure binary with no separate database server to run.","importance":0.8,"tags":["ghost","decision","sqlite"]}
{"key":"decision_links","category":"decision","content":"Decided on A-MEM-style note-level memory links rather than entity-triple graph extraction, because triple extraction added LLM cost without improving recall.","importance":0.8,"tags":["ghost","decision","graph"]}
{"key": "path_filter_docs", "category": "convention", "content": "Heavy workflows path-filter to the directories they validate so a docs typo does not run the full matrix.", "importance": 0.6, "tags": ["ci", "cost"]}
{"key": "least_action_permissions", "category": "convention", "content": "Workflows declare permissions: read-all or narrower; the default token never gets write by inheritance.", "importance": 0.8, "tags": ["ci", "security"]}
{"key": "helm_diff_gate", "category": "gotcha", "content": "helmfile diff must show only the intended release changes before apply; a diff showing unrelated releases means the selector or branch is wrong.", "importance": 0.9, "tags": ["helm", "safety"]}
{"key": "dedup_threshold", "category": "dependency", "content": "Near-duplicate demotion uses related links at strength >= 0.90 plus duplicate links from upsert merge; the threshold is configurable as linking.demotion_threshold.", "importance": 0.6, "tags": ["ghost", "dedup"]}
{"key": "alert_runbook_link", "category": "convention", "content": "Every page-worthy alert annotation includes a runbook URL; alerts without runbooks are disabled until one exists.", "importance": 0.7, "tags": ["observability", "alerting"]}
{"key": "runbook_freshness", "category": "convention", "content": "Runbooks carry last-verified dates; something not exercised in 6 months is reviewed before the next incident needs it.", "importance": 0.6, "tags": ["docs", "ops"]}
{"key": "upsert_merge", "category": "pattern", "content": "Saving near-identical content upserts: the existing row's importance is strengthened, the new content is stored as its own row, and a duplicate link joins them.", "importance": 0.7, "tags": ["ghost", "upsert"]}
{"key": "pool_ticker", "category": "fact", "content": "The registered pool ticker must be unique across the registry at registration time.", "importance": 0.7, "tags": ["cardano", "pool"]}
{"key": "reward_addr", "category": "fact", "content": "Pool rewards accumulate to the reward account registered on-chain; withdrawing requires the payment key of that address.", "importance": 0.7, "tags": ["cardano", "rewards"]}
{"key": "epoch_length", "category": "fact", "content": "A Cardano epoch lasts 5 days (432000 slots at 1-second slot length on mainnet).", "importance": 0.6, "tags": ["cardano", "epochs"]}
{"key": "relay_public", "category": "gotcha", "content": "Relays must accept connections from unknown peers; restricting relay ingress to known IPs breaks federation for the whole pool.", "importance": 0.8, "tags": ["cardano", "relay"]}
{"key": "bp_firewall", "category": "gotcha", "content": "The block producer firewall must allow inbound only from the pool's own relays; exposing the BP to the public internet risks key compromise.", "importance": 0.9, "tags": ["cardano", "security"]}
{"key": "config_preview", "category": "dependency", "content": "Preview network uses network magic 2 and config files distinct from preprod (magic 1); mixing configs causes handshake failures.", "importance": 0.7, "tags": ["cardano", "networks"]}
{"key": "mithril_snapshot", "category": "architecture", "content": "Mithril provides signed chain-state snapshots so a fresh node can bootstrap without replaying history from genesis.", "importance": 0.7, "tags": ["cardano", "mithril"]}
{"key": "tx_submit_port", "category": "fact", "content": "The tx-submit-api service accepts signed transactions over HTTP on port 8090 by default.", "importance": 0.6, "tags": ["cardano", "submit"]}
{"key": "semver_tags", "category": "convention", "content": "Releases are annotated semver tags (vX.Y.Z); lightweight tags are not used because the release workflow keys off annotated tag events.", "importance": 0.8, "tags": ["release", "git"]}
{"key": "branch_naming", "category": "convention", "content": "Feature branches are named feat/<slug>, fix/<slug>, or chore/<slug> and are deleted immediately after the PR merges.", "importance": 0.7, "tags": ["workflow", "git"]}
{"key": "commit_conventions", "category": "convention", "content": "Commit messages use Conventional Commits (feat/fix/chore/docs with optional scope); no AI attribution or Co-Authored-By trailers.", "importance": 0.8, "tags": ["workflow", "git"]}
{"key": "pr_squash", "category": "convention", "content": "PRs merge with squash so main history is one commit per change; feature branches are deleted on merge.", "importance": 0.7, "tags": ["github", "git"]}
{"key": "branch_protect", "category": "architecture", "content": "main is protected: required checks, required review, no force-push; even admins merge through a PR.", "importance": 0.9, "tags": ["github", "policy"]}
{"key": "signed_commits", "category": "preference", "content": "Commits are GPG-signed from the machine holding the key; unsigned commits show as Unverified on the account with vigilant mode on.", "importance": 0.8, "tags": ["git", "security"]}
{"key": "pause_on_red", "category": "preference", "content": "Stop the line on a red main: investigating immediately is cheaper than stacking merges on a broken base.", "importance": 0.8, "tags": ["ci", "process"]}
{"key": "hook_session_start", "category": "pattern", "content": "On session start the hook injects up to 15 project memories plus globals, ranked by decayed importance with a behavior-category floor.", "importance": 0.8, "tags": ["ghost", "hook"]}
{"key": "hook_stop_lifecycle", "category": "pattern", "content": "The stop hook spawns a detached ghost lifecycle that runs reflect, resolve, then supersede for the project, guarded by a PID lock.", "importance": 0.8, "tags": ["ghost", "lifecycle"]}
{"key": "scratch_root", "category": "gotcha", "content": "All harness spawns chdir into a Ghost-owned 0700 scratch directory used as TMPDIR so Ghost can never fill the system temp.", "importance": 0.8, "tags": ["ghost", "scratch"]}
{"key": "harness_detect", "category": "pattern", "content": "Reflect/resolve/supersede classify through the calling harness detected from env markers and process ancestry; detection failure exits with an actionable --source hint.", "importance": 0.9, "tags": ["ghost", "harness"]}
{"key": "resolve_batch", "category": "pattern", "content": "Resolve classifies up to 8 memories per harness call with a numbered verdict protocol and caches KEEP results by content hash.", "importance": 0.7, "tags": ["ghost", "resolve"]}
{"key": "supersede_batch", "category": "pattern", "content": "Supersede classifies 8 candidate pairs per harness call because pair-wise calls dominated lifecycle cost on large projects.", "importance": 0.7, "tags": ["ghost", "supersede"]}
{"key": "empty_set_guard", "category": "gotcha", "content": "Reflection refuses to replace all memories with an empty set; an empty consolidation result is treated as a malformed run, not a successful wipe.", "importance": 0.9, "tags": ["ghost", "reflection"]}
{"key": "guarded_drop", "category": "pattern", "content": "Guarded categories (gotcha, dependency, preference, convention) are re-inserted verbatim when reflection would drop them without a token-surviving replacement.", "importance": 0.8, "tags": ["ghost", "reflection"]}
{"key": "fts_term_cap", "category": "pattern", "content": "FTS queries are sanitized to at most 10 OR-terms; raising the cap let the FTS leg beat fused hybrid on the graded bench, inverting the architecture claim.", "importance": 0.7, "tags": ["ghost", "search"]}
{"key": "vector_fallback", "category": "pattern", "content": "When Ollama is down or a query fails to embed, search falls back to FTS-only and still applies decay and demotion so results never go empty solely from embedding failure.", "importance": 0.8, "tags": ["ghost", "search"]}
{"key": "time_decay_categories", "category": "architecture", "content": "Preference, convention, and fact never decay; pattern and architecture decay over 45 days; decision, gotcha, and dependency decay over 30 days.", "importance": 0.8, "tags": ["ghost", "decay"]}
{"key": "pinned_exempt", "category": "pattern", "content": "Pinned memories are fully exempt from time decay and always score at raw importance regardless of age.", "importance": 0.7, "tags": ["ghost", "decay"]}
{"key": "content_cap", "category": "fact", "content": "Memory content is truncated at 2000 bytes on save; write several focused memories instead of one long one.", "importance": 0.6, "tags": ["ghost", "limits"]}
{"key": "project_lookup", "category": "pattern", "content": "Project resolution tries id, then name, then longest path prefix, then basename; a miss scopes queries to _global only.", "importance": 0.7, "tags": ["ghost", "projects"]}
{"key": "opencode_plugin", "category": "architecture", "content": "Ghost's opencode integration is a lifecycle plugin installed by ghost mcp init --client opencode, not an mcp key in opencode.json.", "importance": 0.8, "tags": ["ghost", "opencode"]}
{"key": "claude_mcp", "category": "architecture", "content": "Claude Code connects to Ghost over stdio MCP configured by ghost mcp init --client claude; the server command is ghost mcp.", "importance": 0.7, "tags": ["ghost", "claude"]}
{"key": "bench_no_judge", "category": "convention", "content": "ghost bench is retrieval-only with committed graded relevance labels; it never calls an LLM judge so results are fully deterministic.", "importance": 0.7, "tags": ["ghost", "bench"]}
{"key": "k8s_probes", "category": "convention", "content": "Every Deployment ships readiness and liveness probes; liveness must not depend on downstream databases or the pod will crash-loop on dependency blips.", "importance": 0.8, "tags": ["k8s", "probes"]}
{"key": "pdb_budget", "category": "gotcha", "content": "PodDisruptionBudgets with minAvailable equal to the replica count block node drains; leave budget for voluntary disruption.", "importance": 0.7, "tags": ["k8s", "pdb"]}
{"key": "network_policy_default", "category": "pattern", "content": "Namespaces start with a default-deny NetworkPolicy; explicit allows accumulate as the real documentation of flow.", "importance": 0.7, "tags": ["k8s", "network"]}
{"key": "rbac_least", "category": "convention", "content": "RBAC grants are namespaced and verb-minimal; cluster-admin is for break-glass only, with alerting on use.", "importance": 0.8, "tags": ["k8s", "security"]}
{"key": "pod_security_baseline", "category": "convention", "content": "Pods run as non-root with read-only rootfs and dropped capabilities under the restricted Pod Security baseline.", "importance": 0.8, "tags": ["k8s", "security"]}
{"key": "image_sign", "category": "pattern", "content": "Production admission requires signed images (cosign); unsigned tags are rejected by the validating webhook.", "importance": 0.7, "tags": ["k8s", "security"]}
{"key": "resource_quota_ns", "category": "convention", "content": "Each namespace has a ResourceQuota and LimitRange so one team cannot consume the whole cluster.", "importance": 0.6, "tags": ["k8s", "quota"]}
{"key": "state_remote", "category": "convention", "content": "Terraform state is remote with locking; a local state file on a laptop is not an acceptable source of truth.", "importance": 0.8, "tags": ["terraform", "workflow"]}
{"key": "plan_apply_split", "category": "convention", "content": "Plan is produced in CI and reviewed; apply runs from that reviewed plan artifact, not from a fresh plan on someone's machine.", "importance": 0.8, "tags": ["terraform", "ci"]}
{"key": "no_manual_tf", "category": "preference", "content": "Cloud resources changed outside Terraform are drifted and will be reverted; fix by importing into the configuration, not by console edits.", "importance": 0.8, "tags": ["terraform", "policy"]}
{"key": "helm_repo_oci", "category": "fact", "content": "Blink Labs charts publish to oci://ghcr.io/blinklabs-io/helm-charts; consumers pin chart versions in values, not latest.", "importance": 0.7, "tags": ["helm", "registry"]}
{"key": "chart_version_bump", "category": "convention", "content": "Any change to a chart requires a Chart.yaml version bump; ct lint in CI enforces it on the target branch.", "importance": 0.7, "tags": ["helm", "ci"]}
{"key": "crd_upgrade", "category": "gotcha", "content": "CRD upgrades are applied before the operator that needs them; the reverse order leaves the operator reconciling against old schemas.", "importance": 0.8, "tags": ["k8s", "crd"]}
{"key": "hook_weight", "category": "gotcha", "content": "Helm hook weights control order; a migrate Job that runs after the Deployment rolls the new code against the old schema.", "importance": 0.8, "tags": ["helm", "hooks"]}
{"key": "gitops_notification", "category": "pattern", "content": "Sync failures notify the owning channel within minutes; a red GitOps status that nobody sees is the same as no GitOps.", "importance": 0.6, "tags": ["gitops", "alerting"]}
{"key": "artifact_promote", "category": "pattern", "content": "The same built artifact promotes dev → staging → prod; rebuilding per environment loses the tested bits.", "importance": 0.7, "tags": ["ci", "release"]}
{"key": "pin_actions_sha", "category": "convention", "content": "GitHub Actions are pinned to full commit SHAs with a version comment; tag-pinned actions are mutable and were compromised industry-wide.", "importance": 0.9, "tags": ["ci", "security"]}
{"key": "pull_request_target", "category": "gotcha", "content": "pull_request_target with checkout of the PR head is a known privilege-escalation pattern; never check out untrusted code in that context.", "importance": 0.9, "tags": ["ci", "security"]}
{"key": "oidc_cloud_auth", "category": "convention", "content": "Cloud deploys authenticate via OIDC federation from CI; long-lived cloud keys in GitHub secrets are retired.", "importance": 0.8, "tags": ["ci", "security"]}
{"key": "environment_protection", "category": "convention", "content": "Production GitHub environments require reviewer approval; workflow_dispatch alone does not equal authorization.", "importance": 0.8, "tags": ["ci", "security"]}
{"key": "workflow_concurrency", "category": "convention", "content": "Workflows set concurrency groups so a superseded push cancels the older run instead of stacking runners.", "importance": 0.6, "tags": ["ci", "cost"]}
{"key": "timeout_min_jobs", "category": "convention", "content": "Every job sets timeout-minutes; a hung job that eats the 6-hour default is a weekly bill and a stuck queue.", "importance": 0.7, "tags": ["ci", "cost"]}
{"key": "context_first_arg", "category": "convention", "content": "ctx is always the first parameter; a function that starts with something else will eventually need a context and break callers.", "importance": 0.7, "tags": ["go", "style"]}
{"key": "timeout_mandatory", "category": "convention", "content": "Every outbound client call sets a timeout; default clients with no timeout are a known source of goroutine leaks.", "importance": 0.8, "tags": ["go", "reliability"]}
{"key": "body_close", "category": "gotcha", "content": "HTTP response bodies must be closed even on error paths after a non-nil resp; unclosed bodies leak connections.", "importance": 0.7, "tags": ["go", "http"]}
{"key": "redirect_policy", "category": "gotcha", "content": "Default HTTP clients follow redirects to link-local addresses (SSRF); production clients use a redirect policy that blocks private ranges.", "importance": 0.8, "tags": ["go", "security"]}
{"key": "error_wrap_context", "category": "convention", "content": "Wrap errors at each layer with operation context (%w); returning a bare fmt.Errorf without %w destroys errors.Is for callers.", "importance": 0.7, "tags": ["go", "errors"]}
{"key": "range_capture", "category": "gotcha", "content": "Loop variable capture in closures needs a per-iteration copy (or Go 1.22+ per-iteration semantics); otherwise every goroutine sees the last value.", "importance": 0.7, "tags": ["go", "concurrency"]}
{"key": "defer_loop", "category": "gotcha", "content": "defer inside a long loop does not run until the function returns; close resources per iteration or extract a helper.", "importance": 0.7, "tags": ["go", "resources"]}
{"key": "copy_locks", "category": "gotcha", "content": "Passing a struct containing a sync.Mutex by value copies the lock; use a pointer or an explicit Clone method.", "importance": 0.7, "tags": ["go", "concurrency"]}
{"key": "channel_close_owner", "category": "gotcha", "content": "Only the sender closes a channel; closing from the receiver side panics under concurrency and is a common review catch.", "importance": 0.7, "tags": ["go", "concurrency"]}
{"key": "map_concurrent", "category": "gotcha", "content": "Concurrent map writes panic; use sync.Map only for the append-mostly shape it is documented for, else a mutex.", "importance": 0.7, "tags": ["go", "concurrency"]}
{"key": "filepath_join_user", "category": "gotcha", "content": "Join user input with filepath.Join then confine with a root check after Clean; absolute components can escape the root on some OS.", "importance": 0.8, "tags": ["go", "security"]}
{"key": "signal_notify_context", "category": "pattern", "content": "signal.NotifyContext for main cancellation; forgetting SIGTERM handling means deploys get SIGKILL after the grace period.", "importance": 0.7, "tags": ["go", "ops"]}
{"key": "fuzz_decoders", "category": "pattern", "content": "Public decoders carry Go fuzz targets; a crash on malformed input is a security bug, not a curiosity.", "importance": 0.7, "tags": ["testing", "fuzz"]}
{"key": "race_on_merge", "category": "convention", "content": "The race-enabled suite is required on merge; a package that fails -race does not merge with a comment promising a follow-up.", "importance": 0.8, "tags": ["testing", "ci"]}
{"key": "mutation_aware", "category": "preference", "content": "A test that passes with the implementation deleted is not a test; reviewers check that assertions would fail on the bug.", "importance": 0.8, "tags": ["testing", "quality"]}
{"key": "verify_before_claim", "category": "preference", "content": "Run the command or test before claiming something works; 'should work' is not evidence.", "importance": 0.9, "tags": ["process", "quality"]}
{"key": "debug_dont_guess", "category": "preference", "content": "Reproduce and root-cause before fixing; a change that makes a red test green without explaining why is not done.", "importance": 0.9, "tags": ["process", "debugging"]}
{"key": "scope_discipline", "category": "preference", "content": "One concern per change; nearby cleanups are proposed, not slipped into the same PR.", "importance": 0.8, "tags": ["process", "review"]}
{"key": "tests_not_optional", "category": "preference", "content": "Behavior changes land with tests; 'I'll add tests later' means the change ships unprotected.", "importance": 0.9, "tags": ["process", "testing"]}
{"key": "password_hash", "category": "convention", "content": "Passwords are hashed with Argon2id (or bcrypt at cost >= 12); a raw or fast hash in the users table is a finding, not a preference.", "importance": 0.9, "tags": ["security", "auth"]}
{"key": "jwt_algs_allowlist", "category": "gotcha", "content": "JWT verification pins an algorithm allowlist (no 'none', no unexpected HS/RS confusion) before any signature check.", "importance": 0.9, "tags": ["security", "jwt"]}
{"key": "oauth_redirect_exact", "category": "gotcha", "content": "OAuth redirect_uri is exact-match registered; a prefix-match validator is a classic account-takeover bug.", "importance": 0.9, "tags": ["security", "oauth"]}
{"key": "pkce_required", "category": "convention", "content": "Public OAuth clients always use PKCE; a public client with only a client_id is not a secret.", "importance": 0.8, "tags": ["security", "oauth"]}
{"key": "cookie_flags", "category": "gotcha", "content": "Session cookies set HttpOnly, Secure, and SameSite; a missing HttpOnly turns any XSS into session theft.", "importance": 0.8, "tags": ["web", "security"]}
{"key": "cors_allowlist", "category": "gotcha", "content": "CORS is an explicit origin allowlist; Access-Control-Allow-Origin: * is never set on authenticated endpoints.", "importance": 0.8, "tags": ["api", "security"]}
{"key": "webhook_verify", "category": "gotcha", "content": "Inbound webhooks are verified against the provider signature with a constant-time compare before any body parsing side effects.", "importance": 0.8, "tags": ["api", "security"]}
{"key": "path_traversal", "category": "gotcha", "content": "File APIs resolve and confine paths under an allowed root with a prefix check after Clean; never join user input and open directly.", "importance": 0.9, "tags": ["security", "files"]}
{"key": "secret_scan_ci", "category": "convention", "content": "CI runs a secret scanner on the diff; a detected key fails the build and the key is rotated, not just removed from the commit.", "importance": 0.8, "tags": ["security", "ci"]}
{"key": "mfa_admin", "category": "preference", "content": "Admin and production-access accounts require MFA; shared accounts without MFA are removed rather than excepted.", "importance": 0.9, "tags": ["security", "auth"]}
{"key": "least_privilege", "category": "preference", "content": "Service accounts get only the permissions they use; quarterly access review removes grants that no longer map to a duty.", "importance": 0.8, "tags": ["security", "iam"]}
{"key": "rotate_after_expose", "category": "preference", "content": "Any exposed credential is rotated even if 'it was probably not used'; the doubt is not worth the risk.", "importance": 0.9, "tags": ["security", "keys"]}
{"key": "tool_allowlist", "category": "gotcha", "content": "Agent tools are an explicit allowlist; a wildcard tool grant is how a prompt-injection turns into data exfiltration.", "importance": 0.9, "tags": ["ml", "security"]}
{"key": "human_approval", "category": "preference", "content": "Irreversible external actions from automations require human approval; the approval is a real identity, not a shared button.", "importance": 0.9, "tags": ["ml", "security"]}
{"key": "pii_redact_prompt", "category": "gotcha", "content": "User content is redacted before it is sent to an external model provider; the redactor runs server-side, not in the browser.", "importance": 0.9, "tags": ["ml", "privacy"]}
{"key": "circuit_breaker", "category": "pattern", "content": "Circuit breakers open after a failure threshold and probe half-open; without them, a dead dependency becomes a thread pool exhaustion bug.", "importance": 0.7, "tags": ["reliability", "design"]}
{"key": "timeout_budget", "category": "pattern", "content": "Downstream timeouts are a fraction of the caller's remaining budget so failures surface before the client gives up.", "importance": 0.7, "tags": ["reliability", "timeouts"]}
{"key": "queue_backpressure", "category": "gotcha", "content": "Unbounded queues convert a slowdown into an outage; producers must see backpressure when consumers fall behind.", "importance": 0.8, "tags": ["design", "queues"]}
{"key": "idempotent_consumer", "category": "pattern", "content": "Queue consumers are idempotent keyed on the message ID so redelivery after a crash cannot double-apply effects.", "importance": 0.7, "tags": ["design", "queues"]}
{"key": "canary_rollout", "category": "pattern", "content": "Risky deploys canary to a single replica or cell first; promotion waits on error-rate and latency guards, not a timer alone.", "importance": 0.7, "tags": ["release", "rollout"]}
{"key": "rollback_fast", "category": "preference", "content": "Rollback must be faster than diagnosis: prefer shipping the previous artifact over debugging under paging pressure.", "importance": 0.8, "tags": ["release", "ops"]}
{"key": "schema_mig_expand", "category": "pattern", "content": "Schema changes follow expand-migrate-contract so old and new code can run against the same database during a deploy.", "importance": 0.8, "tags": ["database", "migrations"]}
{"key": "cache_stampede", "category": "gotcha", "content": "Cache rebuilds need singleflight or jittered TTLs; thundering herds on expiry take down the origin that the cache was protecting.", "importance": 0.7, "tags": ["caching", "reliability"]}
{"key": "clock_skew", "category": "gotcha", "content": "Do not order events by wall-clock timestamp alone across hosts; use a logical clock or the source's sequence number.", "importance": 0.7, "tags": ["design", "distributed"]}
{"key": "error_budget", "category": "convention", "content": "Reliability work is prioritized from the error budget: when the budget is burnt, feature work pauses until SLOs recover.", "importance": 0.6, "tags": ["sre", "process"]}
{"key": "postmortem_blameless", "category": "preference", "content": "Postmortems are blameless and action-itemed; naming individuals as the cause is treated as a process failure of the review itself.", "importance": 0.8, "tags": ["sre", "process"]}
{"key": "saturation_first", "category": "pattern", "content": "Alert on saturation (queue depth, CPU, connection pool) before user-facing errors; saturation gives lead time to act.", "importance": 0.7, "tags": ["sre", "alerting"]}
{"key": "metrics_cardinality", "category": "gotcha", "content": "Labels with user IDs or URLs blow up metric cardinality and can OOM the scraper; label with a bounded enum instead.", "importance": 0.8, "tags": ["observability", "prometheus"]}
{"key": "redact_pii_logs", "category": "gotcha", "content": "Log redaction runs at the sink as defense in depth; relying on every call site to remember to scrub is how tokens end up in log storage.", "importance": 0.8, "tags": ["logging", "security"]}
{"key": "backup_test_freq", "category": "convention", "content": "Restore tests run monthly for tier-1 and quarterly for tier-2; the schedule is on the calendar, not in a wiki hope.", "importance": 0.7, "tags": ["backup", "dr"]}
{"key": "two_person_rule", "category": "preference", "content": "Production credential changes and key rotations require a second person to verify the result.", "importance": 0.8, "tags": ["ops", "security"]}
{"key": "change_freeze", "category": "convention", "content": "Change freeze covers major holidays and the pool's critical epochs; only break-glass moves during freeze.", "importance": 0.7, "tags": ["ops", "process"]}
{"key": "api_versioning", "category": "pattern", "content": "Public HTTP APIs version in the path (/v1/...); breaking changes ship as a new version, never as a silent field removal.", "importance": 0.7, "tags": ["api", "versioning"]}
{"key": "idempotency_keys", "category": "pattern", "content": "POST endpoints that create resources accept an Idempotency-Key header so client retries cannot double-charge or double-create.", "importance": 0.7, "tags": ["api", "reliability"]}
{"key": "pagination_cursor", "category": "architecture", "content": "High-churn list endpoints use opaque cursors rather than offsets so concurrent inserts cannot skip or duplicate rows.", "importance": 0.6, "tags": ["api", "pagination"]}
{"key": "deprecation_window", "category": "convention", "content": "API deprecations announce with Sunset headers and a minimum 90-day window before removal.", "importance": 0.7, "tags": ["api", "process"]}
{"key": "proto_backward", "category": "gotcha", "content": "Protobuf field numbers are never reused after removal; reuse decodes old payloads as the wrong field with no error.", "importance": 0.8, "tags": ["api", "protobuf"]}
{"key": "outbox_pattern", "category": "pattern", "content": "State change and event publish share a transaction via the outbox table; dual-write without an outbox loses events under crash.", "importance": 0.7, "tags": ["design", "reliability"]}
{"key": "schema_registry", "category": "architecture", "content": "Kafka payloads are registered in the schema registry with compatibility checks; producers cannot deploy a breaking schema.", "importance": 0.7, "tags": ["kafka", "schema"]}
{"key": "dlq_required", "category": "convention", "content": "Every consumer has a dead-letter queue with an alert; poison messages are parked, not retried forever.", "importance": 0.7, "tags": ["kafka", "reliability"]}
{"key": "embedding_dim_pin", "category": "gotcha", "content": "Changing the embedding model without re-embedding leaves old vectors dimension-incompatible; SearchVector skips them with a warning until backfill.", "importance": 0.8, "tags": ["ml", "embeddings"]}
{"key": "ollama_local", "category": "preference", "content": "Embeddings run on local Ollama, not a hosted API, so memory content never leaves the machine for vectorization.", "importance": 0.8, "tags": ["ml", "embeddings"]}
{"key": "hybrid_rag", "category": "architecture", "content": "RAG retrieval is hybrid BM25 + vector with RRF, matching the Ghost search architecture so exact identifiers and paraphrases both hit.", "importance": 0.7, "tags": ["ml", "rag"]}
{"key": "prompt_version", "category": "convention", "content": "Production prompts are versioned files in the repo, not strings in a dashboard; prompt changes go through PR review.", "importance": 0.7, "tags": ["ml", "prompt"]}
{"key": "eval_harness", "category": "pattern", "content": "Prompt or model changes run the eval harness with a frozen dataset; a drop in eval score blocks the promote step.", "importance": 0.7, "tags": ["ml", "testing"]}
{"key": "ssh_bastion", "category": "architecture", "content": "SSH to production hosts is via the Tailscale address plane only; no host exposes SSH to the public internet.", "importance": 0.8, "tags": ["ssh", "security"]}
{"key": "sudo_limited", "category": "convention", "content": "Automation accounts have a minimal sudoers drop-in for the commands they run; broad NOPASSWD: ALL is not granted.", "importance": 0.7, "tags": ["sudo", "security"]}
{"key": "immutable_infra", "category": "preference", "content": "Instances are replaced, not patched in place, except for data nodes under a documented maintenance procedure.", "importance": 0.7, "tags": ["ops", "policy"]}
{"key": "config_secret_ref", "category": "gotcha", "content": "Config files reference secrets by path/SSM name, never inline; an inline secret in git history requires rotation, not just a revert.", "importance": 0.9, "tags": ["secrets", "config"]}
{"key": "env_overrides", "category": "pattern", "content": "Precedence is flags > env > file > defaults; documenting the order stops the class of bugs where a stale env var wins silently.", "importance": 0.7, "tags": ["config", "ops"]}
{"key": "boot_validate", "category": "gotcha", "content": "Validate required config at startup and fail fast; deferring validation to first use turns a deploy mistake into a midnight page.", "importance": 0.8, "tags": ["config", "reliability"]}
{"key": "docs_as_code", "category": "preference", "content": "Documentation lives in the repo next to the code it describes and is reviewed in the same PR; wiki pages are not the source of truth.", "importance": 0.7, "tags": ["docs", "workflow"]}
{"key": "adr_records", "category": "convention", "content": "Significant design choices get a short ADR in docs/adr/ with context, decision, and consequences; chat decisions are not durable.", "importance": 0.6, "tags": ["docs", "architecture"]}
{"key": "evidence_citations", "category": "preference", "content": "Findings cite file:line or a command output; summaries without evidence are treated as hypotheses.", "importance": 0.8, "tags": ["process", "quality"]}
{"key": "no_driveby_refactor", "category": "preference", "content": "Refactors are their own PR with their own tests; mixing refactor and behavior change makes both harder to review and revert.", "importance": 0.8, "tags": ["process", "review"]}
{"key": "automate_repeat", "category": "preference", "content": "If a runbook step is done three times, it becomes a script with a test; documentation of manual steps is a bridge, not a destination.", "importance": 0.7, "tags": ["process", "automation"]}
{"key": "incident_severity", "category": "convention", "content": "Sev1 is customer-visible full outage or data risk; severity is declared by the commander in the incident channel, not debated later.", "importance": 0.7, "tags": ["sre", "incident"]}
{"key": "status_page", "category": "convention", "content": "Sev1 and Sev2 post to the status page within 30 minutes; silence is treated as a communication failure in the review.", "importance": 0.7, "tags": ["sre", "incident"]}
{"key": "dry_run_default", "category": "pattern", "content": "Destructive CLI operations default to dry-run and require an explicit --apply; confirmation by re-typing the target name guards project deletes.", "importance": 0.8, "tags": ["ghost", "cli"]}
{"key": "restore_snapshot", "category": "pattern", "content": "Reflection writes a pre-apply snapshot so --restore can undo a consolidation; without the snapshot a bad merge is permanent.", "importance": 0.8, "tags": ["ghost", "reflection"]}
{"key": "access_count_boost", "category": "pattern", "content": "Frequently accessed memories can receive an importance bump on upsert so repeatedly useful notes rise in ranking.", "importance": 0.6, "tags": ["ghost", "ranking"]}
{"key": "global_no_decay", "category": "fact", "content": "Global memories are ranked pinned-first then by importance and recency; they do not use the project category-decay formula.", "importance": 0.6, "tags": ["ghost", "global"]}
{"key": "hybrid_rrf_k", "category": "fact", "content": "Reciprocal rank fusion uses k=60; both retrieval legs fetch limit*2 candidates before fusion.", "importance": 0.6, "tags": ["ghost", "search"]}
{"key": "min_vector_sim", "category": "fact", "content": "Vector candidates with non-positive cosine similarity are dropped before fusion so they cannot claim the full vector weight.", "importance": 0.6, "tags": ["ghost", "search"]}
{"key": "resolve_kept_hash", "category": "pattern", "content": "KEEP verdicts are cached by content hash with a version prefix so a rubric change can invalidate the cache without a schema rewrite.", "importance": 0.6, "tags": ["ghost", "resolve"]}
{"key": "empty_source_fail", "category": "pattern", "content": "When no calling harness can be determined, classification fails fast with an actionable --source hint instead of silently defaulting to claude.", "importance": 0.8, "tags": ["ghost", "harness"]}
{"key": "lifecycle_pid_lock", "category": "gotcha", "content": "A second lifecycle for the same project is refused while the PID lock is held; stale locks are detected and reclaimed carefully.", "importance": 0.7, "tags": ["ghost", "lifecycle"]}
{"key": "reflect_skip_unchanged", "category": "pattern", "content": "Reflect --skip-unchanged fingerprints the consolidatable set (excluding access counts) so an unchanged corpus makes no LLM call.", "importance": 0.7, "tags": ["ghost", "reflection"]}
{"key": "schema_version_bump", "category": "gotcha", "content": "Altering an existing table requires a schemaVersion bump and a migrate.go step; CREATE TABLE IF NOT EXISTS never migrates old databases.", "importance": 0.8, "tags": ["ghost", "sqlite"]}
{"key": "open_db_guard", "category": "pattern", "content": "OpenDB refuses a database whose user_version is ahead of the binary's schemaVersion so a downgrade cannot silently misread tables.", "importance": 0.7, "tags": ["ghost", "sqlite"]}
{"key": "obsidian_one_way", "category": "architecture", "content": "The Obsidian vault mirror is one-way export; editing Markdown in the vault does not write back to the Ghost database.", "importance": 0.6, "tags": ["ghost", "obsidian"]}
{"key": "claude_import_once", "category": "pattern", "content": "Claude Code auto-memory is imported one time on first contact, not continuously synced.", "importance": 0.6, "tags": ["ghost", "claude"]}
{"key": "mcp_init_idempotent", "category": "convention", "content": "ghost mcp init is idempotent and non-destructive — safe to re-run when client config drifts.", "importance": 0.7, "tags": ["ghost", "mcp"]}
{"key": "link_cascade", "category": "pattern", "content": "Memory links cascade-delete with their memories and self-heal after reflection rewrites content.", "importance": 0.6, "tags": ["ghost", "links"]}
{"key": "graph_expansion_off", "category": "decision", "content": "Graph link-expansion ranking was evaluated and removed: a deeper vector-k dominated it and LongMemEval showed a strict subset of recoveries.", "importance": 0.7, "tags": ["ghost", "decision"]}
{"key": "session_cap_15", "category": "fact", "content": "Session-start injects at most 15 project memories and 8 globals, with a behavior-category floor of 8 slots by default.", "importance": 0.6, "tags": ["ghost", "injection"]}
{"key": "truncation_utf8", "category": "pattern", "content": "Injected memory truncation is UTF-8 safe and appends an ellipsis so multi-byte content never splits mid-rune.", "importance": 0.5, "tags": ["ghost", "injection"]}
{"key": "quote_data_delims", "category": "pattern", "content": "Stored memory text is wrapped in guillemet delimiters in prompts and injections so data cannot escape as instructions.", "importance": 0.8, "tags": ["ghost", "security"]}
{"key": "hook_skip_subagent", "category": "pattern", "content": "Session-start injection skips subagent sessions and resume events to avoid paying the injection cost repeatedly.", "importance": 0.6, "tags": ["ghost", "injection"]}
{"key": "compact_points_context", "category": "pattern", "content": "On compaction the hook emits a one-line pointer to call ghost_project_context instead of re-injecting the full block.", "importance": 0.5, "tags": ["ghost", "injection"]}
{"key": "resolve_not_in_hook", "category": "gotcha", "content": "Resolved memories stay searchable with a [resolved] tag but are excluded from ranked session-start injection.", "importance": 0.7, "tags": ["ghost", "resolve"]}
{"key": "search_category_approx", "category": "gotcha", "content": "Category filtering on ghost_memory_search is approximate (pool fetch then filter); use ghost_memories_list for exhaustive browsing.", "importance": 0.6, "tags": ["ghost", "search"]}
{"key": "search_all_includes_global", "category": "pattern", "content": "Both project search and cross-project search include _global rows so shared rules are always findable.", "importance": 0.6, "tags": ["ghost", "search"]}
{"key": "bench_sweep_weights", "category": "fact", "content": "Bench sweep shows vector weights 0.3-0.7 all near-equal NDCG; only vec >= 0.8 degrades, so 70/30 ships unchanged.", "importance": 0.6, "tags": ["ghost", "bench"]}
{"key": "longmemeval_floor", "category": "fact", "content": "LongMemEval hybrid floors are R@5 >= 0.91 and NDCG@10 >= 0.89 at session level n=470.", "importance": 0.6, "tags": ["ghost", "bench"]}
{"key": "staleness_suite", "category": "pattern", "content": "The staleness suite proves decay lifts fresh-wins while the recency-trap suite guards older-correct facts from being buried.", "importance": 0.7, "tags": ["ghost", "bench"]}
{"key": "fts_only_no_ollama", "category": "pattern", "content": "Without Ollama the graded bench still runs FTS-only; vector fixture vectors keep hybrid/vector conditions CI-safe.", "importance": 0.6, "tags": ["ghost", "bench"]}
{"key": "energy_reflect_categories", "category": "gotcha", "content": "Reflect output categories are validated to the eight-value set before write so one bad category cannot fail the whole apply transaction.", "importance": 0.7, "tags": ["ghost", "reflection"]}
{"key": "contamination_guard", "category": "pattern", "content": "Reflection drops emitted memories that name a known other project absent from the input corpus, logging each drop with a preview.", "importance": 0.7, "tags": ["ghost", "reflection"]}
{"key": "supersede_injection", "category": "pattern", "content": "GetTopMemories and the session hook apply the same supersede demotion as search so a superseded memory cannot outrank its replacement in injection.", "importance": 0.7, "tags": ["ghost", "injection"]}
{"key": "scratch_reap_24h", "category": "pattern", "content": "Harness scratch directories are reaped after 24h at lifecycle start and ghost mcp init so temp usage cannot grow unbounded.", "importance": 0.6, "tags": ["ghost", "scratch"]}
{"key": "detector_darwin_ps", "category": "gotcha", "content": "On macOS without /proc, harness detection walks ancestors via ps and must not misidentify a deploy script path containing codex.js.", "importance": 0.6, "tags": ["ghost", "harness"]}
{"key": "restore_no_llm", "category": "pattern", "content": "ghost reflect --restore is a pure DB undo and is exempt from harness detection so it works from a harness-free shell.", "importance": 0.7, "tags": ["ghost", "cli"]}
{"key": "model_pin_per_phase", "category": "pattern", "content": "Each lifecycle phase is its own process, so per-phase model pins are applied by setting GHOST_OPENCODE_MODEL right after bootstrap.", "importance": 0.6, "tags": ["ghost", "lifecycle"]}
{"key": "decision_record_tool", "category": "convention", "content": "Architectural choices are recorded with ghost_decision_record so alternatives and rationale survive the session that made them.", "importance": 0.6, "tags": ["ghost", "workflow"]}
{"key": "task_ids_survive", "category": "pattern", "content": "Ghost tasks persist across sessions with stable IDs so follow-up work is not lost when a context window ends.", "importance": 0.6, "tags": ["ghost", "workflow"]}
{"key": "memory_categories_eight", "category": "fact", "content": "Ghost memory categories are exactly: architecture, decision, pattern, convention, gotcha, dependency, preference, fact.", "importance": 0.7, "tags": ["ghost", "schema"]}
{"key": "importance_clamp", "category": "fact", "content": "Importance is clamped to [0,1] on save and on reflect parse; the default on MCP save is 0.7.", "importance": 0.5, "tags": ["ghost", "schema"]}
{"key": "source_reflection", "category": "fact", "content": "Rows written by consolidation carry source=reflection; manual saves carry source=manual and are never deleted by ReplaceNonManual.", "importance": 0.6, "tags": ["ghost", "schema"]}
{"key": "pin_survives_reflect", "category": "pattern", "content": "Pinned and manual memories are excluded from consolidation input and from ReplaceNonManual deletes.", "importance": 0.8, "tags": ["ghost", "reflection"]}
{"key": "link_strength_threshold", "category": "fact", "content": "Cosine related-links are created at strength >= 0.70 by default; demotion uses a higher 0.90 threshold.", "importance": 0.6, "tags": ["ghost", "links"]}
{"key": "embedding_interval", "category": "fact", "content": "The embedding worker sweeps every 2 minutes and embeds up to 50 unembedded IDs per project per pass.", "importance": 0.5, "tags": ["ghost", "embedding"]}
{"key": "ollama_alive_marker", "category": "pattern", "content": "When Ollama is down the worker writes a down-since marker consumed by ghost mcp status so outages are visible without digging through logs.", "importance": 0.6, "tags": ["ghost", "embedding"]}
{"key": "health_coverage", "category": "fact", "content": "ghost_health reports embedding coverage percent, Ollama reachability, model presence, and memory-link counts.", "importance": 0.5, "tags": ["ghost", "health"]}
{"key": "memory_search_limit", "category": "fact", "content": "ghost_memory_search defaults to limit 10 and accepts up to 100; project context defaults to 20.", "importance": 0.5, "tags": ["ghost", "mcp"]}
{"key": "no_empty_replace", "category": "pattern", "content": "ReplaceNonManual refuses to replace the entire non-manual set with an empty result, treating it as a malformed consolidation.", "importance": 0.9, "tags": ["ghost", "reflection"]}
{"key": "partial_phase_fail", "category": "pattern", "content": "A partial classify pass fails fatally rather than applying incomplete resolve/supersede results.", "importance": 0.7, "tags": ["ghost", "lifecycle"]}
{"key": "batch_verdict_parse", "category": "gotcha", "content": "Batch verdict parsing is strict first-field so prose like '1: This was resolved, but keep it' cannot yield RESOLVED.", "importance": 0.8, "tags": ["ghost", "resolve"]}
{"key": "content_keyed_cache", "category": "pattern", "content": "Supersede NEITHER verdicts are cached by ordered content-keyed pair so a converged project makes zero harness calls.", "importance": 0.6, "tags": ["ghost", "supersede"]}
{"key": "annotated_release_tags", "category": "convention", "content": "Ghost releases use annotated tags; creating a tag triggers release.yml but deleting one does not.", "importance": 0.7, "tags": ["ghost", "release"]}
{"key": "worktree_before_long", "category": "pattern", "content": "Long validation runs use isolated worktrees so a dirty main checkout is never corrupted by a concurrent experiment.", "importance": 0.6, "tags": ["workflow", "git"]}
{"key": "pr_before_investigate", "category": "convention", "content": "Before investigating a reported bug, check open PRs and issues for the same behavior; re-fixing merged work wastes a day.", "importance": 0.9, "tags": ["workflow", "github"]}
{"key": "delete_branch_after_merge", "category": "preference", "content": "Delete feature branches immediately after PR merge; never leave stale branches accumulating.", "importance": 0.9, "tags": ["workflow", "git"]}
{"key": "helmfile_env_flag", "category": "fact", "content": "helmfile environments are selected with -e (for example -e default); releases can be scoped with -l selectors.", "importance": 0.6, "tags": ["helmfile", "infra"]}
{"key": "sops_age_key_id", "category": "fact", "content": "The Age recipient used for SOPS in the infra repo is age1jt2untdg6g0l0qqhuq04wq0vz2laj76m9xs8t88krrhckghkfc8ssnmk3q.", "importance": 0.7, "tags": ["sops", "age"]}
{"key": "k3s_native_tailscale", "category": "architecture", "content": "The K3s clusters use native Tailscale vpn-auth mode for node join rather than a public kube-apiserver exposure.", "importance": 0.7, "tags": ["k3s", "tailscale"]}
{"key": "arc_self_hosted", "category": "architecture", "content": "CI runs on GitHub Actions Runner Controller with self-hosted runners inside the cluster, not GitHub-hosted runners.", "importance": 0.6, "tags": ["ci", "arc"]}
{"key": "makefile_no_bench", "category": "fact", "content": "The Makefile has build/test/test-race/vet/lint/clean/install only; bench is a ghost subcommand, not a make target.", "importance": 0.5, "tags": ["make", "tools"]}
{"key": "go_module_version", "category": "dependency", "content": "The module declares go 1.24; CI builds against the module directive.", "importance": 0.6, "tags": ["go", "toolchain"]}
{"key": "docker_multi_stage", "category": "convention", "content": "Dockerfiles use multi-stage builds so compilers and git never ship in runtime images.", "importance": 0.7, "tags": ["docker", "images"]}
{"key": "no_latest_base", "category": "convention", "content": "Base images pin digest or minor tag; :latest in a Dockerfile is rejected in review.", "importance": 0.8, "tags": ["docker", "supply-chain"]}
{"key": "dependabot_weekly", "category": "convention", "content": "Dependabot checks Go modules and GitHub Actions weekly; updates land as normal PRs.", "importance": 0.5, "tags": ["ci", "deps"]}
{"key": "codeowners_paths", "category": "convention", "content": "CODEOWNERS requires owning-team review for infra and workflow paths; self-merge is not allowed there.", "importance": 0.7, "tags": ["github", "review"]}
{"key": "review_sla", "category": "convention", "content": "Reviews are requested within the working day; PRs older than two days get a re-request rather than silence.", "importance": 0.5, "tags": ["github", "process"]}
{"key": "draft_pr_first", "category": "preference", "content": "Open PRs as draft while iterating; mark ready only when CI is green and the description matches the final change.", "importance": 0.5, "tags": ["github", "workflow"]}
{"key": "change_mgmt_pr", "category": "preference", "content": "Production changes go through the same PR + review path as code; hotfixes get a retroactive PR the same day.", "importance": 0.8, "tags": ["ops", "policy"]}
{"key": "runbook_alert", "category": "convention", "content": "Paging alerts include a runbook URL; alerts without runbooks are treated as noise.", "importance": 0.7, "tags": ["ops", "alerting"]}
{"key": "oncall_handoff", "category": "convention", "content": "On-call handoff records open incidents, in-flight deploys, and known flakes before the shift changes.", "importance": 0.6, "tags": ["ops", "process"]}
{"key": "patch_window", "category": "convention", "content": "Host patching happens in the monthly window unless a CVE forces an out-of-window cycle.", "importance": 0.6, "tags": ["ops", "security"]}
{"key": "backup_immutable", "category": "pattern", "content": "Backups are object-locked for retention so ransomware cannot rewrite the recovery point.", "importance": 0.7, "tags": ["backup", "security"]}
{"key": "dr_rpo_rto", "category": "fact", "content": "Documented RPO is 15 minutes and RTO is 4 hours for tier-1 services; tier-2 is 1 hour / 24 hours.", "importance": 0.7, "tags": ["dr", "sre"]}
{"key": "failover_dns", "category": "pattern", "content": "Failover flips DNS with short TTL and health-gated weighted records rather than manual IP edits.", "importance": 0.6, "tags": ["dns", "dr"]}
{"key": "spot_batch_only", "category": "pattern", "content": "Batch and CI use Spot with checkpointing; the production request path never sits on Spot.", "importance": 0.6, "tags": ["finops", "capacity"]}
{"key": "cost_anomaly", "category": "pattern", "content": "Daily cloud cost anomaly detection opens a ticket on >20% swings so runaway jobs are caught in a day.", "importance": 0.6, "tags": ["finops", "ops"]}
{"key": "dns_ttl_30", "category": "fact", "content": "Service DNS TTLs are 30s so failovers propagate quickly; only static marketing records use longer TTLs.", "importance": 0.5, "tags": ["dns", "ops"]}
{"key": "audit_forward", "category": "architecture", "content": "Authentication logs forward to the central log store so local rotation cannot erase an incident trail.", "importance": 0.6, "tags": ["logging", "security"]}
{"key": "vuln_scan_pr", "category": "pattern", "content": "Image vulnerability scans run on PR for base images and nightly on tags; criticals block the next deploy.", "importance": 0.6, "tags": ["security", "ci"]}
{"key": "sbom_release", "category": "convention", "content": "Release artifacts include an SBOM generated at build time; releases without SBOMs are not published.", "importance": 0.6, "tags": ["security", "release"]}
{"key": "error_messages_actionable", "category": "preference", "content": "Error messages state what failed and what to do next; an error that only restates the exception wastes the reader's time.", "importance": 0.7, "tags": ["cli", "ux"]}
{"key": "log_levels", "category": "convention", "content": "Verbose diagnostics go to debug; spamming info/warn trains operators to ignore the log stream.", "importance": 0.6, "tags": ["logging", "ops"]}
{"key": "metrics_naming", "category": "convention", "content": "Metric names read as units with base units matching Prometheus conventions (seconds, bytes, total).", "importance": 0.6, "tags": ["observability", "prometheus"]}
{"key": "dashboard_as_code", "category": "convention", "content": "Grafana dashboards live as JSON in the repo and are applied by the provisioner; UI edits are for local experiments only.", "importance": 0.7, "tags": ["observability", "grafana"]}
{"key": "trace_attributes", "category": "convention", "content": "Span attributes use OTel semantic conventions so the same operation joins across services.", "importance": 0.6, "tags": ["observability", "tracing"]}
{"key": "correlation_id", "category": "convention", "content": "Every request carries a correlation ID from edge to storage so one user report can be reconstructed.", "importance": 0.7, "tags": ["observability", "logging"]}
{"key": "trace_sampling", "category": "pattern", "content": "Traces sample head-based at 5% steady state and force-sample on errors so incidents keep full fidelity.", "importance": 0.6, "tags": ["observability", "tracing"]}
{"key": "synthetic_checks", "category": "convention", "content": "Synthetic transactions hit the critical path every minute from outside the cluster.", "importance": 0.7, "tags": ["sre", "monitoring"]}
{"key": "flamegraph_incident", "category": "pattern", "content": "During a latency incident, grab a CPU profile and flame graph before changing code; the profile names the hotspot.", "importance": 0.6, "tags": ["observability", "performance"]}
{"key": "pprof_internal", "category": "convention", "content": "pprof is exposed on an internal debug port, never on the public listener.", "importance": 0.7, "tags": ["go", "observability"]}
{"key": "gc_tuning", "category": "pattern", "content": "Go services under memory pressure get GOGC and GOMEMLIMIT tuned from heap profiles before adding more RAM blindly.", "importance": 0.6, "tags": ["go", "performance"]}
{"key": "alloc_bench", "category": "convention", "content": "Allocation-sensitive code is checked with go test -bench -benchmem; a B/op regression is treated like a failing test.", "importance": 0.5, "tags": ["go", "performance"]}
{"key": "single_writer", "category": "pattern", "content": "Each partition has a single writer; multi-writer contention is resolved by moving the partition, not by adding locks.", "importance": 0.6, "tags": ["design", "scaling"]}
{"key": "shard_key", "category": "pattern", "content": "Shard keys are chosen for even heat and co-tenant locality; a key that funnels all writes to one node fails the purpose.", "importance": 0.6, "tags": ["design", "scaling"]}
{"key": "hot_partition", "category": "gotcha", "content": "A single celebrity key can hotspot one partition; salting or a local cache in front of the hot key is the usual fix.", "importance": 0.7, "tags": ["design", "scaling"]}
{"key": "search_index_lag", "category": "fact", "content": "Secondary search indexes are near-real-time with up to a few seconds of lag; UI that needs read-your-writes reads the primary.", "importance": 0.6, "tags": ["search", "consistency"]}
{"key": "sort_stability", "category": "gotcha", "content": "Unstable sort with equal scores makes pagination skip or duplicate rows; tie-break by a unique key after the score.", "importance": 0.7, "tags": ["search", "pagination"]}
{"key": "deep_pagination", "category": "gotcha", "content": "Offset pagination past 10k rows times out; deep export paths use cursor pagination or an async export job.", "importance": 0.6, "tags": ["search", "pagination"]}
{"key": "boost_freshness", "category": "pattern", "content": "Freshness boost is a small multiplier on recency-biased categories only; applying it to all results buries stable truths.", "importance": 0.6, "tags": ["search", "ranking"]}
{"key": "zero_result_review", "category": "convention", "content": "Zero-result queries are reviewed weekly; they are the cheapest source of synonym and missing-doc fixes.", "importance": 0.6, "tags": ["search", "process"]}
{"key": "query_timeout_2s", "category": "convention", "content": "Search queries carry a 2s timeout; a slow query returns partial results with a flag rather than holding a connection open.", "importance": 0.6, "tags": ["search", "reliability"]}
{"key": "cold_index_ready", "category": "gotcha", "content": "A brand-new index serves zero results until the first background build finishes; readiness for the search role waits on index health.", "importance": 0.6, "tags": ["search", "ops"]}
{"key": "index_rebuild_dr", "category": "pattern", "content": "Search indexes are rebuildable from the primary store and are not part of the DR restore path; restoring the primary rebuilds them.", "importance": 0.6, "tags": ["search", "dr"]}
{"key": "contract_tests", "category": "convention", "content": "Provider/consumer contract tests run in CI against recorded fixtures so an API change breaks the producer build, not the customer.", "importance": 0.6, "tags": ["testing", "api"]}
{"key": "openapi_source", "category": "convention", "content": "The OpenAPI document is the source of truth for external HTTP APIs; clients generate from it and handlers assert against it.", "importance": 0.6, "tags": ["api", "codegen"]}
{"key": "golden_files", "category": "convention", "content": "Stable text outputs are golden-file tested with an explicit -update flag for regeneration.", "importance": 0.6, "tags": ["testing", "fixtures"]}
{"key": "property_roundtrip", "category": "pattern", "content": "Codec changes assert encode(decode(x)) == x on generated cases; roundtrip properties catch what examples miss.", "importance": 0.6, "tags": ["testing", "codecs"]}
{"key": "integration_no_net", "category": "convention", "content": "Unit and integration tests run without network access; tests that need the internet are tagged and excluded from default CI.", "importance": 0.7, "tags": ["testing", "ci"]}
{"key": "testdata_tmpdir", "category": "convention", "content": "Fixtures live under testdata/ and are read-only to the test; tests never write outside t.TempDir().", "importance": 0.7, "tags": ["testing", "go"]}
{"key": "skip_reason_required", "category": "convention", "content": "t.Skip messages state the missing dependency so a skipped test is diagnosable from CI logs alone.", "importance": 0.6, "tags": ["testing", "ci"]}
{"key": "flake_quarantine", "category": "pattern", "content": "Known flakes are quarantined with an issue link and an owner; quarantined tests do not silently vanish from CI.", "importance": 0.7, "tags": ["testing", "ci"]}
{"key": "coverage_gate", "category": "pattern", "content": "Coverage is gated on new packages; assertion-free coverage gaming is rejected in review.", "importance": 0.6, "tags": ["testing", "process"]}
{"key": "bisect_regression", "category": "pattern", "content": "For a regression between two known goods, git bisect with the failing test as the oracle beats reading the diff by eye.", "importance": 0.7, "tags": ["git", "debugging"]}
{"key": "minimal_repro", "category": "convention", "content": "Bug reports ship a minimal reproduction; issues without one are asked for a repro before investigation starts.", "importance": 0.7, "tags": ["process", "bugs"]}
{"key": "fix_forward_link", "category": "convention", "content": "When a release is bad, the fix-forward PR links the incident or issue so the trail from symptom to repair is one click.", "importance": 0.6, "tags": ["release", "process"]}
{"key": "hotfix_forward_merge", "category": "pattern", "content": "Hotfixes branch from the release tag, then forward-merge to main so the fix is not lost on the next train.", "importance": 0.7, "tags": ["release", "git"]}
{"key": "n_minus_one", "category": "convention", "content": "The previous minor of the CLI/API is supported for one release cycle after a breaking change ships.", "importance": 0.6, "tags": ["release", "compat"]}
{"key": "migration_forward_only", "category": "pattern", "content": "Database migrations are forward-only with expand/contract; down migrations are not trusted in production restores.", "importance": 0.7, "tags": ["database", "migrations"]}
{"key": "seed_anonymize", "category": "convention", "content": "Staging data is anonymized from production; copying raw personal data into lower environments is prohibited.", "importance": 0.8, "tags": ["data", "privacy"]}
{"key": "audit_trail", "category": "convention", "content": "Mutating admin actions write an audit record with actor, action, target, and timestamp before the mutation is acknowledged.", "importance": 0.7, "tags": ["security", "audit"]}
{"key": "pii_minimize", "category": "preference", "content": "Collect the minimum PII needed for the feature; logs and metrics never include raw emails or tokens.", "importance": 0.8, "tags": ["security", "privacy"]}
{"key": "session_rotation", "category": "pattern", "content": "Session IDs rotate on privilege change (login, password reset) to defeat fixation; old IDs are invalidated server-side.", "importance": 0.7, "tags": ["security", "auth"]}
{"key": "key_rotation_sched", "category": "convention", "content": "API tokens and signing keys rotate on a schedule and on personnel change; long-lived static tokens without expiry are discouraged.", "importance": 0.7, "tags": ["security", "keys"]}
{"key": "mTLS_internal", "category": "architecture", "content": "Service-to-service mTLS is required inside the mesh perimeter; plaintext internal RPC is rejected by policy.", "importance": 0.8, "tags": ["security", "tls"]}
{"key": "cert_auto_renew", "category": "convention", "content": "TLS certificates auto-renew with alerting at 21 days remaining; manual renewals are for the break-glass CA only.", "importance": 0.7, "tags": ["tls", "ops"]}
{"key": "subresource_integrity", "category": "convention", "content": "Third-party script tags carry SRI hashes; a CDN compromise without SRI becomes stored XSS on every page.", "importance": 0.7, "tags": ["web", "security"]}
{"key": "csp_incremental", "category": "pattern", "content": "CSP ships in Report-Only first, violations are triaged, then enforcement flips; blocking on day one breaks the app in novel ways.", "importance": 0.7, "tags": ["web", "security"]}
{"key": "hsts_year_no_preload", "category": "convention", "content": "HSTS max-age starts at 1 year without preload until HTTPS is confirmed everywhere; preload is hard to undo.", "importance": 0.6, "tags": ["web", "security"]}
{"key": "content_type_nosniff", "category": "convention", "content": "X-Content-Type-Options: nosniff is set on all responses so an uploaded file cannot be sniffed into script.", "importance": 0.7, "tags": ["web", "security"]}
{"key": "referrerpolicy", "category": "convention", "content": "Referrer-Policy: strict-origin-when-cross-origin so query-string secrets do not leak via Referer to third parties.", "importance": 0.6, "tags": ["web", "security"]}
{"key": "file_upload_limits", "category": "gotcha", "content": "Upload handlers enforce size, type, and count limits before writing to disk; missing limits turn a form into a disk-fill attack.", "importance": 0.8, "tags": ["security", "uploads"]}
{"key": "presigned_short", "category": "pattern", "content": "Direct-to-storage uploads use short-lived presigned URLs scoped to one key and size cap; long-lived credentials in the browser are forbidden.", "importance": 0.8, "tags": ["security", "uploads"]}
{"key": "archive_bomb", "category": "gotcha", "content": "Archive extraction enforces entry count, total size, and path checks; zip-slip and decompression bombs are treated as hostile input.", "importance": 0.8, "tags": ["security", "files"]}
{"key": "csv_injection", "category": "gotcha", "content": "CSV exports escape formula-leading cells (=, +, -) so a download opened in Excel does not execute attacker formulas.", "importance": 0.7, "tags": ["security", "exports"]}
{"key": "ws_auth_cookie", "category": "gotcha", "content": "WebSocket upgrades authenticate via cookie or a short-lived ticket; putting tokens in the query string leaks them to logs.", "importance": 0.8, "tags": ["websocket", "security"]}
{"key": "idempotent_webhook_retry", "category": "pattern", "content": "Webhook senders retry with backoff and the same event ID; receivers dedupe on that ID before side effects.", "importance": 0.7, "tags": ["webhooks", "reliability"]}
{"key": "callback_allowlist", "category": "gotcha", "content": "Configured callback/redirect URLs are validated against an allowlist to block SSRF through customer-supplied endpoints.", "importance": 0.8, "tags": ["security", "ssrf"]}
{"key": "npm_lock_ci", "category": "convention", "content": "package-lock.json is committed and CI uses npm ci; floating installs produce different trees per machine.", "importance": 0.7, "tags": ["javascript", "ci"]}
{"key": "ts_strict", "category": "convention", "content": "tsconfig strict is on; any is limited to boundary decoders with a comment justifying it.", "importance": 0.7, "tags": ["typescript", "style"]}
{"key": "eslint_max_warnings", "category": "convention", "content": "CI runs eslint --max-warnings 0 so warnings do not accumulate into an unlinted codebase.", "importance": 0.6, "tags": ["javascript", "ci"]}
{"key": "component_by_role", "category": "convention", "content": "UI components ship with interaction tests that query by role, not by CSS class, so refactors do not silently break affordances.", "importance": 0.6, "tags": ["frontend", "testing"]}
{"key": "e2e_smoke_gate", "category": "convention", "content": "A short e2e smoke path (login, primary action) gates deploy; the full e2e suite runs nightly.", "importance": 0.7, "tags": ["frontend", "testing"]}
{"key": "a11y_gate", "category": "convention", "content": "New interactive UI passes an automated a11y scan; serious violations block merge.", "importance": 0.7, "tags": ["frontend", "a11y"]}
{"key": "dataloader_batch", "category": "pattern", "content": "N+1 resolver loads go through a DataLoader batch keyed per request; per-row queries in resolvers are a review blocker on hot paths.", "importance": 0.7, "tags": ["graphql", "performance"]}
{"key": "persisted_queries", "category": "pattern", "content": "Persisted queries lock the operation set for production clients so arbitrary GraphQL depth cannot be introspected from the edge.", "importance": 0.7, "tags": ["graphql", "security"]}
{"key": "codegen_graphql", "category": "convention", "content": "GraphQL types are generated from the schema in CI; hand-edited generated files fail the diff check.", "importance": 0.6, "tags": ["graphql", "ci"]}
{"key": "cache_headers_static", "category": "convention", "content": "Fingerprinted static assets get immutable long max-age; HTML entry points get no-cache so deploys are visible immediately.", "importance": 0.6, "tags": ["web", "caching"]}
{"key": "gzip_brotli", "category": "convention", "content": "Text responses compress at the edge (brotli preferred, gzip fallback); images and video are pre-compressed.", "importance": 0.5, "tags": ["web", "performance"]}
{"key": "warmup_email", "category": "convention", "content": "New sending domains warm up on a volume schedule; day-one full volume guarantees placement problems.", "importance": 0.6, "tags": ["email", "ops"]}
{"key": "dmarc_none_then_reject", "category": "convention", "content": "Email domains publish DMARC; policy starts at none, moves to quarantine, then reject as false positives clear.", "importance": 0.6, "tags": ["email", "security"]}
{"key": "spf_lookup_limit", "category": "gotcha", "content": "SPF lookup chains must stay under 10 DNS lookups; a deep include chain silently breaks mail delivery.", "importance": 0.6, "tags": ["email", "dns"]}
{"key": "list_unsubscribe", "category": "convention", "content": "Bulk mail carries List-Unsubscribe + One-Click; manual unsubscribe instructions alone fail modern provider requirements.", "importance": 0.5, "tags": ["email", "compliance"]}
{"key": "partition_count_plan", "category": "pattern", "content": "Partition counts are planned for peak throughput with headroom; re-partitioning later is a migration project, not a config flip.", "importance": 0.6, "tags": ["kafka", "capacity"]}
{"key": "producer_acks", "category": "gotcha", "content": "acks=all with min.insync.replicas=2 for durable topics; acks=none on a 'durable' log is wishful thinking.", "importance": 0.7, "tags": ["kafka", "reliability"]}
{"key": "consumer_groups", "category": "pattern", "content": "Each consumer group scales by partitions, not by threads; adding instances beyond partition count does not add throughput.", "importance": 0.6, "tags": ["kafka", "scaling"]}
{"key": "exactly_once_rejected", "category": "decision", "content": "End-to-end exactly-once was rejected in favor of idempotent effects plus at-least-once delivery; the distributed transaction cost was not worth it.", "importance": 0.6, "tags": ["decision", "kafka"]}
{"key": "cdc_debezium", "category": "architecture", "content": "Database changes stream via CDC into the bus so the warehouse and the search index follow the primary without bespoke triggers.", "importance": 0.6, "tags": ["cdc", "kafka"]}
{"key": "data_quality_tests", "category": "convention", "content": "Pipelines declare column tests (not-null, range, freshness); a failing test fails the run and pages the data on-call.", "importance": 0.6, "tags": ["data", "testing"]}
{"key": "warehouse_materialize", "category": "pattern", "content": "Analyst-facing tables are materialized; scanning raw event logs for dashboards is banned after the first runaway query bill.", "importance": 0.6, "tags": ["data", "finops"]}
{"key": "model_registry", "category": "architecture", "content": "Models are versioned in a registry with the training data snapshot ID; serving loads only promoted versions.", "importance": 0.6, "tags": ["ml", "release"]}
{"key": "canary_model", "category": "pattern", "content": "New model versions canary on a traffic slice with automatic rollback on quality-metric regression.", "importance": 0.6, "tags": ["ml", "release"]}
{"key": "llm_budget_alert", "category": "convention", "content": "Each product surface has a monthly token budget; alerting fires at 80% so behavior can change before hard limits.", "importance": 0.6, "tags": ["ml", "finops"]}
{"key": "retrieval_topk", "category": "pattern", "content": "RAG retrieves top-k=20 and reranks to 5 before the prompt; stuffing the raw top-20 into context degrades answer precision.", "importance": 0.6, "tags": ["ml", "rag"]}
{"key": "chunk_size_500", "category": "pattern", "content": "Documents chunk at ~500 tokens with 50-token overlap; chunking by headers beats fixed size for Markdown runbooks.", "importance": 0.6, "tags": ["ml", "rag"]}
{"key": "batch_embed_cache", "category": "pattern", "content": "Embedding jobs batch inputs (64 per call) with a content-hash cache so unchanged text is never re-embedded.", "importance": 0.6, "tags": ["ml", "embeddings"]}
{"key": "synonym_config", "category": "pattern", "content": "Domain synonyms (e.g. deploy→rollout) live in a config file reviewed like code, not hardcoded in query parsers.", "importance": 0.5, "tags": ["search", "config"]}
{"key": "stopwords_lexical_only", "category": "convention", "content": "English stopword removal is applied only to the lexical leg; removing stopwords from embeddings or phrase queries hurts recall.", "importance": 0.5, "tags": ["search", "nlp"]}
{"key": "light_stemming", "category": "decision", "content": "Light suffix stripping only (plural s/es); aggressive stemming folded distinct API names and was rolled back.", "importance": 0.5, "tags": ["decision", "search"]}
{"key": "spell_correction_deferred", "category": "decision", "content": "Query spell-correction was deferred: the vector leg already recovers most typos, and wrong corrections were worse than the typos.", "importance": 0.5, "tags": ["decision", "search"]}
{"key": "result_explain", "category": "pattern", "content": "Debug search can return per-leg ranks and fused scores; explanations are how weighting regressions are diagnosed without guessing.", "importance": 0.5, "tags": ["search", "debug"]}
{"key": "facet_separate_pass", "category": "pattern", "content": "Facet counts come from a separate cheap aggregation pass, not from re-scoring the full result set.", "importance": 0.5, "tags": ["search", "performance"]}
{"key": "highlight_server_side", "category": "convention", "content": "Result snippets highlight matched terms server-side with offsets so clients cannot XSS their own query terms.", "importance": 0.6, "tags": ["search", "security"]}
{"key": "multi_tenant_index", "category": "pattern", "content": "Per-tenant indexes isolate noisy neighbors; a shared index with a tenant filter leaks performance, not data, but still pages the wrong on-call.", "importance": 0.6, "tags": ["search", "multi-tenant"]}
{"key": "read_only_search_replica", "category": "architecture", "content": "Search queries hit read-only replicas; index builds and backfills never run on the serving primary.", "importance": 0.6, "tags": ["search", "architecture"]}
{"key": "index_compact", "category": "pattern", "content": "Indexes are compacted on a schedule after heavy delete waves; without compaction, deleted terms still cost disk and scan time.", "importance": 0.5, "tags": ["search", "ops"]}
{"key": "personalization_rejected", "category": "decision", "content": "Per-user personalization of rankings was rejected for internal tools: shared team ranking made results explainable in review.", "importance": 0.5, "tags": ["decision", "search"]}
{"key": "click_feedback_offline", "category": "pattern", "content": "Click-through is logged as implicit feedback for offline eval only; it does not live-update the ranker without a review.", "importance": 0.5, "tags": ["search", "ml"]}
{"key": "ab_ranking_holdback", "category": "convention", "content": "Ranking changes ship behind an experiment with a holdback; a ranking tweak without a holdback cannot be attributed later.", "importance": 0.6, "tags": ["search", "experiment"]}
{"key": "search_slo_100ms", "category": "fact", "content": "Search p95 latency SLO is 100ms server-side for top-20 fusion; anything slower is a bug, not a capacity issue, until proven otherwise.", "importance": 0.6, "tags": ["search", "slo"]}
{"key": "index_size_budget", "category": "convention", "content": "Each index has a size budget; growth past budget triggers a retention or shard review before the disk fills.", "importance": 0.5, "tags": ["search", "capacity"]}
{"key": "events_additive_first", "category": "pattern", "content": "Internal events follow the same compatibility rules as public APIs: additive fields first, removals only after all consumers upgrade.", "importance": 0.6, "tags": ["api", "events"]}
{"key": "client_retry_jitter", "category": "convention", "content": "Client retry policies use full jitter; synchronized retries after a blip are a classic self-inflicted outage.", "importance": 0.7, "tags": ["api", "reliability"]}
{"key": "load_shed", "category": "pattern", "content": "Under extreme load the edge sheds lowest-priority traffic first (health of the whole over perfection of one endpoint).", "importance": 0.6, "tags": ["reliability", "capacity"]}
{"key": "priority_queue", "category": "architecture", "content": "Work queues are split by priority class; bulk imports never sit in the same queue as user-facing jobs.", "importance": 0.6, "tags": ["design", "queues"]}
{"key": "fairness_limit", "category": "gotcha", "content": "Without per-tenant fairness, one noisy tenant starves the rest; weighted fair queuing is applied at the ingest tier.", "importance": 0.7, "tags": ["design", "multi-tenant"]}
{"key": "graceful_degrade", "category": "pattern", "content": "Degrade in layers: disable recommendations, then personalization, then secondary writes — keep the primary path up.", "importance": 0.7, "tags": ["reliability", "product"]}
{"key": "dynamic_config_scope", "category": "pattern", "content": "Dynamic config only changes runtime-tunable values (timeouts, limits); anything affecting durable data format requires a deploy.", "importance": 0.6, "tags": ["config", "design"]}
{"key": "typed_config", "category": "pattern", "content": "Config unmarshals into a typed struct with validation at boot; unknown keys warn so a typo'd field does not silently keep the default.", "importance": 0.7, "tags": ["config", "go"]}
{"key": "config_drift_detect", "category": "pattern", "content": "Desired config lives in git; a daily drift report diffs live state against git and opens an issue on mismatch.", "importance": 0.7, "tags": ["gitops", "config"]}
{"key": "pets_vs_cattle", "category": "pattern", "content": "Stateless services are cattle (replace freely); stateful nodes have names, runbooks, and change windows.", "importance": 0.6, "tags": ["ops", "architecture"]}
{"key": "capacity_review", "category": "convention", "content": "Capacity is reviewed monthly against growth; buy-before-shortage for disk and connections, not after the incident.", "importance": 0.6, "tags": ["capacity", "sre"]}
{"key": "module_semver", "category": "convention", "content": "Shared Terraform modules are semver-tagged; consumers pin versions and upgrade via PR so changes are reviewable.", "importance": 0.7, "tags": ["terraform", "versioning"]}
{"key": "provider_pin", "category": "convention", "content": "Provider versions are pinned in required_providers; floating latest breaks plans on provider majors.", "importance": 0.7, "tags": ["terraform", "deps"]}
{"key": "values_schema", "category": "pattern", "content": "Charts with a values.schema.json validate user input at install time so a typo'd value fails early with a clear message.", "importance": 0.6, "tags": ["helm", "validation"]}
{"key": "network_policy_note", "category": "convention", "content": "Egress NetworkPolicies are used for high-risk namespaces where data exfil path control matters more than operational flexibility.", "importance": 0.6, "tags": ["k8s", "security"]}
{"key": "image_pull_policy", "category": "convention", "content": "Production images pin by digest or immutable tag with imagePullPolicy IfNotPresent; latest tags are forbidden in production values.", "importance": 0.7, "tags": ["k8s", "images"]}
{"key": "ci_cache_go", "category": "pattern", "content": "Go build cache in CI is keyed on go.sum hash so dependency-only changes skip full module downloads.", "importance": 0.5, "tags": ["ci", "go"]}
{"key": "pr_env_preview", "category": "pattern", "content": "PRs can spin ephemeral environments with a TTL; they are destroyed on merge and never hold production secrets.", "importance": 0.6, "tags": ["ci", "preview"]}
{"key": "dependabot_grouped", "category": "convention", "content": "Patch-level dependency PRs with green CI can merge after review comments settle; majors always get a human.", "importance": 0.5, "tags": ["ci", "deps"]}
{"key": "license_header_check", "category": "convention", "content": "Source files carry the project license header where required; missing headers fail the license-check CI step.", "importance": 0.5, "tags": ["legal", "ci"]}
{"key": "editorconfig_eol", "category": "convention", "content": ".editorconfig pins charset, newline, and trailing-whitespace rules so diffs do not fight the formatter.", "importance": 0.5, "tags": ["editor", "workflow"]}
{"key": "gofmt_gate", "category": "convention", "content": "gofmt -l must be empty before merge; the CI fmt check is authoritative over any local editor setting.", "importance": 0.7, "tags": ["go", "ci"]}
{"key": "imports_grouped", "category": "convention", "content": "Go imports are grouped stdlib, external, internal with goimports; hand-sorted groups drift and fail review.", "importance": 0.5, "tags": ["go", "style"]}
{"key": "naming_stutter", "category": "convention", "content": "Package-qualified names do not stutter: package memory does not export MemoryStore.CreateMemory.", "importance": 0.5, "tags": ["go", "style"]}
{"key": "interface_consumer", "category": "pattern", "content": "Accept interfaces, return structs; interfaces are declared at the consumer, not the producer, and stay one-method where possible.", "importance": 0.6, "tags": ["go", "design"]}
{"key": "option_structs", "category": "pattern", "content": "Growing option sets use an options struct rather than a 6-parameter function; nil options means defaults.", "importance": 0.6, "tags": ["go", "design"]}
{"key": "zero_value_useful", "category": "pattern", "content": "Types are useful at the zero value where practical; requiring New() for every struct invites nil bugs at call sites.", "importance": 0.6, "tags": ["go", "design"]}
{"key": "atomic_single_discipline", "category": "gotcha", "content": "atomic.AddInt64 on a field that is also read non-atomically is a data race; pick one discipline for the whole struct.", "importance": 0.7, "tags": ["go", "concurrency"]}
{"key": "waitgroup_add_before", "category": "gotcha", "content": "Add must happen before the goroutine starts; Add inside the goroutine races with Wait and intermittently misses the counter.", "importance": 0.7, "tags": ["go", "concurrency"]}
{"key": "slice_grow_copy", "category": "gotcha", "content": "Appending to a slice shared with another writer silently overwrites; clone before appending when ownership is unclear.", "importance": 0.6, "tags": ["go", "slices"]}
{"key": "time_parse_layout", "category": "gotcha", "content": "time.Parse needs the exact reference layout; mixing RFC3339 and SQLite's '2006-01-02 15:04:05' is a recurring bug source.", "importance": 0.7, "tags": ["go", "time"]}
{"key": "time_utc_server", "category": "convention", "content": "Servers store and compare UTC; local time enters only at presentation.", "importance": 0.6, "tags": ["go", "time"]}
{"key": "duration_units", "category": "gotcha", "content": "time.ParseDuration needs units; a bare integer is an error, not seconds — validate config durations at boot.", "importance": 0.6, "tags": ["go", "config"]}
{"key": "build_tags_windows", "category": "gotcha", "content": "OS-specific files need _windows/_linux suffixes or build tags; a missing tag makes the Windows build fail only on release day.", "importance": 0.7, "tags": ["go", "cross-compile"]}
{"key": "cgo_cross", "category": "gotcha", "content": "Cross-compiling with CGO requires a cross toolchain; pure-Go builds set CGO_ENABLED=0 and ship everywhere.", "importance": 0.7, "tags": ["go", "build"]}
{"key": "goprivate", "category": "gotcha", "content": "Private module paths need GOPRIVATE or git insteadOf config; the default proxy 404s on private repos and confuses the error.", "importance": 0.7, "tags": ["go", "modules"]}
{"key": "no_vendor", "category": "decision", "content": "vendor/ is not committed: CI and releases build from the module proxy with go.sum verification; vendoring doubled the diff size for no gain.", "importance": 0.6, "tags": ["decision", "go"]}
{"key": "go_mod_tidy", "category": "convention", "content": "go mod tidy is clean before merge; a dirty go.mod/go.sum means a missing import or an unused dependency.", "importance": 0.7, "tags": ["go", "ci"]}
{"key": "gowork_local", "category": "pattern", "content": "Local multi-module development uses go.work (gitignored) so editors resolve cross-module imports without replace commits.", "importance": 0.5, "tags": ["go", "modules"]}
{"key": "version_ldflags", "category": "convention", "content": "Version strings are injected with -ldflags -X so the binary reports its exact tag and commit without runtime git access.", "importance": 0.6, "tags": ["release", "go"]}
{"key": "release_matrix", "category": "convention", "content": "Release builds produce linux/darwin/windows × amd64/arm64 binaries with -trimpath and stripped symbols for supportable panics.", "importance": 0.6, "tags": ["release", "go"]}
{"key": "checksum_artifacts", "category": "convention", "content": "Release assets ship SHA256SUMS; install scripts verify the checksum before chmod +x.", "importance": 0.7, "tags": ["release", "security"]}
{"key": "image_tags_immutable", "category": "convention", "content": "Version tags on images are immutable; latest is only a rolling convenience for dev compose files.", "importance": 0.7, "tags": ["release", "docker"]}
{"key": "registry_gc", "category": "pattern", "content": "Registry cleanup keeps the last N versions and all non-pruneable release tags; untagged layers age out after 30 days.", "importance": 0.5, "tags": ["release", "docker"]}
{"key": "docs_link_check", "category": "convention", "content": "CI link-checks docs so a renamed file does not leave a year of dead bookmarks.", "importance": 0.5, "tags": ["docs", "ci"]}
{"key": "bus_factor_docs", "category": "preference", "content": "Anything only one person can deploy gets a recorded walkthrough within two sprints; bus factor of one is an operational risk, not a badge.", "importance": 0.7, "tags": ["process", "docs"]}
{"key": "toil_quarterly", "category": "convention", "content": "Toil is manual, automatable, reactive, and lacking durable value; each quarter the top toil items get automation tickets.", "importance": 0.5, "tags": ["sre", "process"]}
{"key": "error_budget_freeze", "category": "pattern", "content": "When the error budget is exhausted the platform freezes non-severity work until the budget recovers or the freeze is explicitly waived.", "importance": 0.6, "tags": ["sre", "process"]}
{"key": "broken_main_siren", "category": "convention", "content": "A red default branch pages the merge owner within the hour; overnight red is discovered by the next continent's morning at the latest.", "importance": 0.7, "tags": ["ci", "process"]}
{"key": "flaky_file_issue", "category": "convention", "content": "A flaky test gets an issue with the failure snippet and an owner in the same day it is first seen.", "importance": 0.7, "tags": ["testing", "process"]}
{"key": "quarantine_expiry", "category": "convention", "content": "Quarantined tests expire after 30 days: fix, delete, or escalate — they do not live forever in a skip list.", "importance": 0.6, "tags": ["testing", "process"]}
{"key": "perf_budget_ui", "category": "convention", "content": "UI performance budgets (LCP, INP) gate releases for user-facing surfaces; a feature that blows the budget does not ship as-is.", "importance": 0.6, "tags": ["performance", "release"]}
{"key": "bundle_budget", "category": "convention", "content": "JS bundle size has a budget per route; exceeding it requires an explicit approval, not a silent merge.", "importance": 0.5, "tags": ["frontend", "performance"]}
{"key": "image_budget", "category": "convention", "content": "Container image size is budgeted per service; a 2GB base for a CLI tool triggers a distroless review.", "importance": 0.5, "tags": ["docker", "performance"]}
{"key": "recording_rules", "category": "pattern", "content": "Dashboards query recording rules for expensive expressions; raw high-cardinality queries at panel load are how Prometheus dies.", "importance": 0.7, "tags": ["observability", "prometheus"]}
{"key": "alert_summary_runbook", "category": "convention", "content": "Every alert has a summary with the affected object and a runbook_url annotation; bare metric names are not alerts.", "importance": 0.7, "tags": ["observability", "alerting"]}
{"key": "multiwindow_burn", "category": "pattern", "content": "Page alerts use multi-window burn-rate so a blip does not page and a slow bleed still does.", "importance": 0.6, "tags": ["observability", "alerting"]}
{"key": "deadmans_switch", "category": "convention", "content": "A DeadMan'sSwitch alert fires if the alerting pipeline itself goes silent — monitoring the monitor.", "importance": 0.6, "tags": ["observability", "alerting"]}
{"key": "silence_expiry", "category": "convention", "content": "Alert silences auto-expire within 24h and require a reason; permanent silences are deletions with extra steps.", "importance": 0.6, "tags": ["observability", "process"]}
{"key": "latency_hist_slo", "category": "gotcha", "content": "Histogram buckets must cover the SLO (e.g. 0.3s for a 300ms SLO); default buckets that top out at 1s make the SLO unreadable.", "importance": 0.7, "tags": ["observability", "slo"]}
{"key": "baggage_allowlist", "category": "gotcha", "content": "Trace baggage is allowlisted; unbounded user-controlled baggage bloats every downstream header.", "importance": 0.6, "tags": ["observability", "security"]}
{"key": "propagation_w3c", "category": "convention", "content": "Context propagation uses W3C traceparent; custom header dialects die at the first framework boundary.", "importance": 0.6, "tags": ["observability", "tracing"]}
{"key": "container_nonroot", "category": "convention", "content": "Dockerfiles end with a non-root USER; an image that starts as root fails the admission policy for production namespaces.", "importance": 0.8, "tags": ["docker", "security"]}
{"key": "distroless_runtime", "category": "pattern", "content": "Runtime images prefer distroless or scratch; shell-full bases are for debug variants only.", "importance": 0.6, "tags": ["docker", "security"]}
{"key": "layer_cache_order", "category": "pattern", "content": "Dockerfile layers order from least to most frequently changed (deps before source) so cache hits survive code edits.", "importance": 0.6, "tags": ["docker", "ci"]}
{"key": "hadolint_gate", "category": "convention", "content": "Hadolint runs on Dockerfile changes; DL3007/DL4006 findings are fixed, not ignored.", "importance": 0.6, "tags": ["docker", "ci"]}
{"key": "trivy_gate", "category": "convention", "content": "Trivy blocks merge on CRITICAL CVEs in the built image; HIGHs get tickets with SLA.", "importance": 0.7, "tags": ["docker", "security"]}
{"key": "cosign_sign", "category": "convention", "content": "Release images are cosign-signed; clusters verify signatures at admission for production.", "importance": 0.7, "tags": ["docker", "supply-chain"]}
{"key": "provenance_slsa", "category": "pattern", "content": "Build provenance follows SLSA-style attestations so a deployed artifact maps back to a source commit and workflow.", "importance": 0.6, "tags": ["security", "supply-chain"]}
{"key": "dependency_review", "category": "convention", "content": "GitHub dependency-review on PRs flags new advisories in introduced dependencies before merge.", "importance": 0.6, "tags": ["ci", "security"]}
{"key": "cache_branch_scope", "category": "convention", "content": "CI caches are scoped per-branch; a PR must not read the main branch's cache of a poisoned dependency.", "importance": 0.7, "tags": ["ci", "security"]}
{"key": "required_check_rename", "category": "gotcha", "content": "Required status check names are stable across workflow renames; renaming a required check silently removes the gate.", "importance": 0.7, "tags": ["ci", "github"]}
{"key": "merge_queue", "category": "pattern", "content": "Merge queue validates the combination before landing so red does not appear from two green PRs merging together.", "importance": 0.7, "tags": ["ci", "github"]}
{"key": "rebase_long_branch", "category": "convention", "content": "Long-lived branches rebase regularly; a 40-commit merge with conflicts in 30 files is self-inflicted pain.", "importance": 0.6, "tags": ["git", "workflow"]}
{"key": "force_push_policy", "category": "convention", "content": "Force-push is for feature branches during review; force-push to main is blocked and is an incident if it ever succeeds.", "importance": 0.9, "tags": ["git", "policy"]}
{"key": "worktree_parallel", "category": "pattern", "content": "Parallel long experiments use git worktrees so one dirty tree does not block an urgent fix on the same repo.", "importance": 0.6, "tags": ["git", "workflow"]}
{"key": "lfs_big_files", "category": "convention", "content": "Files over 50MB go to Git LFS; committing multi-hundred-MB binaries to git history is permanent tax.", "importance": 0.6, "tags": ["git", "storage"]}
{"key": "gitattributes_eol", "category": "convention", "content": ".gitattributes normalizes EOLs so Windows contributors do not rewrite whole files with CRLF.", "importance": 0.5, "tags": ["git", "hygiene"]}
{"key": "precommit_not_authority", "category": "pattern", "content": "Pre-commit hooks run fmt/vet fast paths; CI remains authoritative because hooks are local and bypassable.", "importance": 0.6, "tags": ["git", "ci"]}
{"key": "security_md", "category": "convention", "content": "SECURITY.md publishes the reporting path and disclosure timeline; security issues do not go to the public tracker.", "importance": 0.7, "tags": ["security", "docs"]}
{"key": "coordinated_disclosure", "category": "convention", "content": "Disclosure is coordinated: fix available, then advisory; no surprise public 0-days against our own services.", "importance": 0.7, "tags": ["security", "process"]}
{"key": "response_sla_72", "category": "convention", "content": "Vulnerability reports get an initial response within 72 hours; silence is interpreted as unresponsiveness, not discretion.", "importance": 0.6, "tags": ["security", "process"]}
{"key": "pen_test_yearly", "category": "convention", "content": "External penetration tests run yearly and before major surface changes; findings track to closure with owners.", "importance": 0.6, "tags": ["security", "process"]}
{"key": "threat_model_surface", "category": "convention", "content": "New external surfaces get a short threat model (assets, entry points, abuses) before build, reviewed like a design doc.", "importance": 0.7, "tags": ["security", "process"]}
{"key": "security_champion", "category": "convention", "content": "Each team has a security champion for quick consults; waiting on a central queue for every question trains people to skip questions.", "importance": 0.6, "tags": ["security", "org"]}
{"key": "shared_account_ban", "category": "preference", "content": "Shared interactive accounts are banned; service identities may be shared with automation, never with humans typing passwords.", "importance": 0.8, "tags": ["security", "iam"]}
{"key": "session_timeout_30", "category": "convention", "content": "Interactive sessions idle-timeout at 30 minutes; long-lived tokens are replaced by short-lived ones with refresh.", "importance": 0.7, "tags": ["security", "auth"]}
{"key": "access_review_quarterly", "category": "convention", "content": "Access reviews run quarterly for all admin groups; stale memberships are removed in the review, not left for next quarter.", "importance": 0.7, "tags": ["security", "iam"]}
{"key": "offboard_fast", "category": "convention", "content": "Offboarding revokes VPN, SSO, and SSH within 1 hour of the effective date; the checklist is automated except the final verify step.", "importance": 0.8, "tags": ["security", "iam"]}
{"key": "restore_isolation", "category": "pattern", "content": "Restores for investigation land in an isolated environment; a restore with production credentials attached is a second incident.", "importance": 0.7, "tags": ["backup", "security"]}
{"key": "snapshot_before_migrate", "category": "convention", "content": "Schema migrations take a snapshot/backup first; expand-only migrations still get a recovery point.", "importance": 0.7, "tags": ["database", "migrations"]}
{"key": "index_concurrent", "category": "convention", "content": "Production index builds use CONCURRENTLY (or the online equivalent); a blocking CREATE INDEX takes the table write path down.", "importance": 0.8, "tags": ["database", "ops"]}
{"key": "explain_before_index", "category": "preference", "content": "Add an index only after EXPLAIN shows the plan needs it; shotgun indexes slow writes and mislead the optimizer.", "importance": 0.7, "tags": ["database", "performance"]}
{"key": "pool_under_max", "category": "pattern", "content": "Pool sizes stay under the DB max_connections budget across all replicas; pool × instances > max is a classic outage.", "importance": 0.7, "tags": ["database", "reliability"]}
{"key": "lock_timeout_migration", "category": "gotcha", "content": "App lock waits shorter than the migration's long transaction fail fast; lock_timeout is set during migrations to avoid pile-ups.", "importance": 0.7, "tags": ["database", "migrations"]}
{"key": "spf_dkim_ready", "category": "convention", "content": "Outbound email domains publish SPF and DKIM before turning on DMARC enforcement.", "importance": 0.6, "tags": ["email", "security"]}
{"key": "warmup_ip_pool", "category": "pattern", "content": "New IP pools warm separately from the domain reputation path; mixing cold IPs with warm domain traffic drags both down.", "importance": 0.5, "tags": ["email", "ops"]}
{"key": "callback_https_only", "category": "convention", "content": "Outbound webhooks require https:// endpoints; plaintext http callbacks are rejected at configuration time.", "importance": 0.7, "tags": ["security", "webhooks"]}
{"key": "event_schema_version", "category": "convention", "content": "Outbound events carry a schema_version field from day one; adding it later means a compatibility shim forever.", "importance": 0.6, "tags": ["api", "events"]}
{"key": "consumer_offset_pii", "category": "gotcha", "content": "Resetting consumer offsets to earliest on a topic with PII retention may reprocess personal data — check retention policy first.", "importance": 0.7, "tags": ["kafka", "compliance"]}
{"key": "compact_vs_delete", "category": "convention", "content": "Topics that must not be rewound use delete retention with careful consumer groups; compacted topics are for changelog state, not event history.", "importance": 0.6, "tags": ["kafka", "design"]}
{"key": "schema_compat_mode", "category": "convention", "content": "Schema registry compatibility mode is BACKWARD for consumers; FULL is used only where old producers must read new events.", "importance": 0.6, "tags": ["kafka", "schema"]}
{"key": "idempotent_producer", "category": "pattern", "content": "Idempotent producers on + retries guard duplicate appends across broker failover.", "importance": 0.6, "tags": ["kafka", "reliability"]}
{"key": "mirror_not_writes", "category": "pattern", "content": "Cross-cluster mirror keeps a warm replica of critical topics for region failover; mirrors are not for load-splitting writes.", "importance": 0.6, "tags": ["kafka", "dr"]}
{"key": "scrape_internal_only", "category": "pattern", "content": "Scrape targets expose metrics on an internal port; the edge never scrapes production user traffic ports.", "importance": 0.5, "tags": ["observability", "security"]}
{"key": "service_monitor_label", "category": "convention", "content": "Prometheus Operator discovers targets via ServiceMonitor labels; a bare Service without labels is invisible to the stack.", "importance": 0.6, "tags": ["observability", "k8s"]}
{"key": "trace_rate_config", "category": "convention", "content": "Trace sample rates are config, not constants, so an incident can raise fidelity without a deploy.", "importance": 0.6, "tags": ["observability", "config"]}
{"key": "alloc_not_inuse", "category": "pattern", "content": "For GC pressure, pprof -alloc_objects finds the churn source; -inuse only shows what survived.", "importance": 0.5, "tags": ["go", "performance"]}
{"key": "block_profile_rate", "category": "gotcha", "content": "Block profiling at rate 1 in production adds overhead; enable temporarily for an investigation, not permanently.", "importance": 0.6, "tags": ["go", "performance"]}
{"key": "rum_sample_privacy", "category": "pattern", "content": "Real-user monitoring samples at a low rate with URL scrubbing; full-fidelity RUM on authenticated pages is a privacy project, not a toggle.", "importance": 0.5, "tags": ["observability", "privacy"]}
{"key": "continuous_profiling", "category": "pattern", "content": "Continuous profiling runs at low frequency; during an incident it is upsampled for the affected service.", "importance": 0.5, "tags": ["observability", "performance"]}
{"key": "dnssec_optional", "category": "pattern", "content": "Public zones are DNSSEC-signed where the registrar supports it; validation failures are monitored via resolver probes.", "importance": 0.5, "tags": ["dns", "security"]}
{"key": "caa_only_issuer", "category": "convention", "content": "CAA records list only the allowed CA so a mis-issued cert from another provider fails issuance.", "importance": 0.6, "tags": ["dns", "pki"]}
{"key": "root_ca_offline", "category": "architecture", "content": "The root CA is offline; only intermediates are loaded on the issuing box so a host compromise cannot mint new trust.", "importance": 0.7, "tags": ["security", "pki"]}
{"key": "ocsp_staple", "category": "pattern", "content": "TLS servers staple OCSP responses so revocation checks do not add a third-party round trip to every handshake.", "importance": 0.5, "tags": ["tls", "performance"]}
{"key": "http2_external", "category": "pattern", "content": "HTTP/2 is on for external TLS endpoints; internal HTTP/1.1 remains where the mesh sidecar still mediates every call.", "importance": 0.5, "tags": ["web", "network"]}
{"key": "keepalive_both", "category": "gotcha", "content": "Raising upstream keepalive without raising the proxy's max_connections just moves the queue; tune both or neither.", "importance": 0.6, "tags": ["web", "ops"]}
{"key": "caa_cname_verify", "category": "gotcha", "content": "Deep CNAME chains add resolution latency and fragility; apex CNAME-to-provider patterns break with CAA records — verify during setup.", "importance": 0.6, "tags": ["dns", "web"]}
{"key": "type_support_window", "category": "convention", "content": "TypeScript types for public packages support the same window as the JS runtime package; types are not allowed to run ahead into unsupported APIs.", "importance": 0.5, "tags": ["typescript", "compat"]}
{"key": "smoke_before_e2e", "category": "convention", "content": "Smoke tests run on every PR; full e2e is nightly; both are required before a release train leaves the station.", "importance": 0.6, "tags": ["testing", "release"]}
{"key": "fixture_not_staging", "category": "convention", "content": "Frontend tests mock network with MSW fixtures checked into the repo; tests do not call staging APIs.", "importance": 0.6, "tags": ["frontend", "testing"]}
{"key": "visual_snap_review", "category": "pattern", "content": "Shared design-system components have visual regression snapshots updated only with a design-review link.", "importance": 0.5, "tags": ["frontend", "testing"]}
{"key": "node_version_file", "category": "convention", "content": ".nvmrc pins the Node version; CI and local dev read the same file so 'works on my node' dies.", "importance": 0.6, "tags": ["javascript", "toolchain"]}
{"key": "prettier_not_mixed", "category": "convention", "content": "Formatting is Prettier in CI; a format-only PR is mechanical and never mixed with logic changes.", "importance": 0.6, "tags": ["javascript", "style"]}
{"key": "sso_all_tools", "category": "convention", "content": "Internal tools authenticate via the central IdP; per-tool password stores are not created for new services.", "importance": 0.7, "tags": ["security", "iam"]}
{"key": "break_glass_tested", "category": "pattern", "content": "Break-glass paths are exercised quarterly so the procedure works when it is needed under pressure.", "importance": 0.6, "tags": ["security", "ops"]}
{"key": "audit_log_retain", "category": "convention", "content": "Audit logs are retained for 1 year minimum, immutable for the first 90 days, and excluded from routine log pruning.", "importance": 0.6, "tags": ["security", "logging"]}
{"key": "data_classify", "category": "convention", "content": "Datasets are classified public/internal/confidential at creation; the classification drives encryption and access-review cadence.", "importance": 0.6, "tags": ["security", "data"]}
{"key": "retention_schedule", "category": "convention", "content": "Each data store has a documented retention period; stores without an owner and retention are deleted rather than kept indefinitely.", "importance": 0.7, "tags": ["data", "compliance"]}
{"key": "erasure_pipeline", "category": "pattern", "content": "User erasure requests flow to every store with personal data via the deletion pipeline; ticket-only erasure that misses a replica is a compliance bug.", "importance": 0.7, "tags": ["privacy", "data"]}
{"key": "legal_hold_system", "category": "pattern", "content": "Legal holds suspend deletion pipelines for named custodians; the hold is a system state, not an email agreement.", "importance": 0.6, "tags": ["compliance", "data"]}
{"key": "forensic_preserve", "category": "convention", "content": "Incident response preserves volatile evidence (disk snapshot, memory capture) before remediation destroys it.", "importance": 0.7, "tags": ["security", "incident"]}
{"key": "chain_of_custody", "category": "convention", "content": "Evidence handling logs chain of custody; an untracked screenshot is not admissible in a later review.", "importance": 0.6, "tags": ["security", "process"]}
{"key": "breach_comms_ready", "category": "convention", "content": "Breach communication templates and counsel contacts are pre-drafted; drafting legal language during an active breach is a mistake.", "importance": 0.7, "tags": ["security", "incident"]}
{"key": "revoke_before_patch", "category": "pattern", "content": "In an active exploit, revoke access first, patch second — containment does not wait for the change window.", "importance": 0.8, "tags": ["security", "incident"]}
{"key": "abuse_case_review", "category": "pattern", "content": "Feature reviews ask 'how is this abused at scale?' — rate, scraping, and cost attacks are product risks, not only security ones.", "importance": 0.6, "tags": ["security", "product"]}
{"key": "patch_critical_track", "category": "convention", "content": "OS patches batch to the weekly window; CVEs rated critical get an out-of-window track with the same review bar.", "importance": 0.6, "tags": ["security", "ops"]}
{"key": "dynamic_secret_db", "category": "pattern", "content": "Database credentials are dynamic with short TTL where the driver supports it; long-lived shared DB passwords are the fallback, not the goal.", "importance": 0.6, "tags": ["secrets", "database"]}
{"key": "secrets_path_convention", "category": "convention", "content": "Runtime secrets load from the secrets manager path convention (svc/<env>/<name>); ad-hoc paths break the rotation automation.", "importance": 0.7, "tags": ["secrets", "ops"]}
{"key": "hpkp_retired", "category": "decision", "content": "HPKP is not used (browser-CTFO); report-only CT and certificate transparency monitoring cover the pinning use case safely.", "importance": 0.5, "tags": ["decision", "tls"]}
{"key": "jwt_leeway_30", "category": "convention", "content": "Clock skew leeway on exp/nbf is 30s max; larger leeway quietly extends stolen token life.", "importance": 0.7, "tags": ["security", "jwt"]}
{"key": "jwks_kid_refresh", "category": "pattern", "content": "JWKS is cached with refresh-on-unknown-kid so key rotation does not take down every verifier simultaneously.", "importance": 0.7, "tags": ["security", "jwt"]}
{"key": "refresh_rotate", "category": "pattern", "content": "Refresh tokens rotate on use and the old one is invalidated after a grace window; stolen refresh tokens die at first use by the legitimate client.", "importance": 0.8, "tags": ["security", "oauth"]}
{"key": "webhook_ip_ranges", "category": "pattern", "content": "Inbound webhooks from known providers are filtered to their published IP ranges at the edge where practical.", "importance": 0.6, "tags": ["security", "webhooks"]}
{"key": "webhook_timeout_5s", "category": "convention", "content": "Outbound webhook calls time out in 5s; a slow receiver must not occupy a worker for 30s.", "importance": 0.6, "tags": ["webhooks", "reliability"]}
{"key": "image_reencode", "category": "pattern", "content": "Uploaded images are re-encoded by a worker (strip EXIF, cap dimensions) so a crafted file never reaches the CDN as-is.", "importance": 0.7, "tags": ["security", "uploads"]}
{"key": "virus_quarantine", "category": "pattern", "content": "User-uploaded files are scanned async and held in quarantine until clean; serving unscanned files from the same origin is how malware spreads.", "importance": 0.7, "tags": ["security", "uploads"]}
{"key": "pdf_sanitize", "category": "pattern", "content": "Generated PDFs come from a sanitizer pipeline; embedding raw user HTML in a PDF library is an XSS/RCE foot-gun.", "importance": 0.6, "tags": ["security", "exports"]}
{"key": "sse_over_ws", "category": "decision", "content": "Server-sent events over WebSocket where the flow is one-way; SSE reconnects natively and needs no custom heartbeat protocol.", "importance": 0.5, "tags": ["decision", "web"]}
{"key": "ws_backpressure", "category": "gotcha", "content": "Slow WebSocket consumers must be disconnected or buffered with a cap; unbounded server-side buffers are a memory leak with a protocol name.", "importance": 0.7, "tags": ["websocket", "reliability"]}
{"key": "redact_structured", "category": "pattern", "content": "Log sinks apply structured redaction of known secret fields as a second layer after application logging.", "importance": 0.7, "tags": ["logging", "defense-in-depth"]}
{"key": "audit_hash_chain", "category": "architecture", "content": "Audit storage is append-only with hash chaining so retroactive edits are detectable.", "importance": 0.7, "tags": ["security", "audit"]}
{"key": "tamper_alert", "category": "pattern", "content": "Alert on audit-gap or hash-chain break; silent tamper detection is not detection.", "importance": 0.7, "tags": ["security", "alerting"]}
{"key": "config_hot_reload", "category": "architecture", "content": "Static config is re-read on SIGHUP where safe; everything else is immutable for the process lifetime to avoid half-applied state.", "importance": 0.6, "tags": ["config", "design"]}
{"key": "feature_dark_launch", "category": "pattern", "content": "High-risk features dark-launch: the code path runs and logs outcomes without user-visible effects until the metrics look right.", "importance": 0.6, "tags": ["release", "safety"]}
{"key": "kill_switch_tested", "category": "pattern", "content": "Each new integration gets a kill switch that disables it without a deploy; the switch is tested in staging before launch.", "importance": 0.7, "tags": ["reliability", "safety"]}
{"key": "flag_default_off", "category": "pattern", "content": "New feature flags default off in production and on in dev; enabling is an explicit, reversible config change.", "importance": 0.6, "tags": ["config", "rollout"]}
{"key": "bulkhead_separate", "category": "architecture", "content": "Worker pools are separate per workload so a slow export cannot consume the API's request-handling goroutines.", "importance": 0.6, "tags": ["design", "concurrency"]}
{"key": "fallback_stale_ok", "category": "pattern", "content": "Read paths that can serve stale data prefer a stale response with a header over a 5xx when the primary is down.", "importance": 0.6, "tags": ["reliability", "caching"]}
{"key": "hedging_cancel", "category": "pattern", "content": "Latency-critical reads may hedge a second request after a p95 threshold; hedges are canceled when the first completes.", "importance": 0.5, "tags": ["reliability", "performance"]}
{"key": "openapi_assert", "category": "convention", "content": "Handlers assert against the OpenAPI document in tests so documentation drift fails CI, not the client integration.", "importance": 0.6, "tags": ["api", "docs"]}
{"key": "grpc_internal", "category": "decision", "content": "Internal service-to-service calls use gRPC; JSON-over-HTTP remains only at the edge where browsers require it.", "importance": 0.6, "tags": ["decision", "api"]}
{"key": "any_unknown_ok", "category": "pattern", "content": "Clients ignore unknown fields deliberately so a server can add data before every client is upgraded.", "importance": 0.6, "tags": ["api", "compat"]}
{"key": "pagination_default_50", "category": "convention", "content": "List endpoints default to page size 50 with a max of 200; unbounded list responses are not allowed on public APIs.", "importance": 0.6, "tags": ["api", "pagination"]}
{"key": "soft_delete_window", "category": "pattern", "content": "User-visible deletes are soft deletes with a retention window; hard delete is a separate admin path with an audit entry.", "importance": 0.6, "tags": ["data", "design"]}
{"key": "uuid_v7_ids", "category": "pattern", "content": "External IDs are UUIDv7 or ULID so they sort by creation time; sequential integers leak volume and break cursor pagination.", "importance": 0.6, "tags": ["api", "ids"]}
{"key": "crypto_rand", "category": "convention", "content": "Tokens and IDs come from crypto/rand; math/rand is for simulations and load tests only.", "importance": 0.8, "tags": ["go", "security"]}
{"key": "tls_min_12", "category": "convention", "content": "Outbound TLS sets MinVersion to TLS 1.2; servers that still offer TLS 1.0/1.1 are treated as misconfigured.", "importance": 0.7, "tags": ["go", "tls"]}
{"key": "panic_recover_http", "category": "pattern", "content": "HTTP handlers recover panics and return 500 so one bad request cannot take down the whole server process.", "importance": 0.7, "tags": ["go", "http"]}
{"key": "nil_map_init", "category": "gotcha", "content": "Writing to a nil map panics; initialize maps at declaration or in the constructor before first write.", "importance": 0.6, "tags": ["go", "maps"]}
{"key": "sync_pool_reset", "category": "gotcha", "content": "sync.Pool is a throughput optimization, not a lifetime store; objects from Pool must be fully reset before reuse.", "importance": 0.7, "tags": ["go", "performance"]}
{"key": "bench_mem_guard", "category": "pattern", "content": "Hot paths that changed for performance include a Go benchmark so regressions are measurable, not anecdotal.", "importance": 0.5, "tags": ["go", "testing"]}
{"key": "typed_errors_wrapped", "category": "pattern", "content": "Go packages return wrapped errors with %w and callers use errors.Is/As; sentinel error variables are named Err<Condition>.", "importance": 0.6, "tags": ["go", "errors"]}
{"key": "struct_logger", "category": "convention", "content": "Logging uses log/slog with structured key-value attributes; positional Printf-style logs are avoided so logs stay queryable.", "importance": 0.6, "tags": ["go", "logging"]}
{"key": "metrics_ghost_prefix", "category": "convention", "content": "Prometheus metrics use a ghost_ prefix and base units (_seconds, _bytes, _total); histogram buckets are seconds for latencies.", "importance": 0.6, "tags": ["go", "metrics"]}
{"key": "feature_flag_revert", "category": "pattern", "content": "Behavior changes ship behind config flags defaulting to the old behavior so a bad rollout can be reverted without a redeploy.", "importance": 0.6, "tags": ["config", "rollout"]}
{"key": "graceful_drain", "category": "pattern", "content": "Servers catch SIGTERM, stop accepting new work, drain in-flight requests within a deadline, then exit; the deadline comes from config.", "importance": 0.7, "tags": ["go", "reliability"]}
{"key": "readiness_vs_liveness", "category": "architecture", "content": "Liveness is process-local; readiness fails when a required dependency is down so traffic is not routed to a pod that cannot serve.", "importance": 0.7, "tags": ["k8s", "health"]}
{"key": "migration_lock_table", "category": "gotcha", "content": "Schema migrations take a lock table so two runners cannot apply the same step; a crashed migration must be manually marked applied before retry.", "importance": 0.8, "tags": ["sqlite", "migrations"]}
{"key": "backup_restore_drill", "category": "preference", "content": "A backup that has never been restored is not a backup; restore drills are scheduled, not aspirational.", "importance": 0.9, "tags": ["backup", "dr"]}
{"key": "cost_tagging", "category": "convention", "content": "Cloud resources carry the standard owner/cost-center tags so spend can be attributed; untagged resources are flagged weekly.", "importance": 0.5, "tags": ["cloud", "finops"]}
{"key": "ntp_sources", "category": "dependency", "content": "Hosts sync time against the pool's NTP peers; unsynchronized hosts are excluded from the monitoring allowlist.", "importance": 0.5, "tags": ["ntp", "ops"]}
{"key": "log_stdout_only", "category": "convention", "content": "Container logs are collected by the cluster logging sidecar; application files inside containers must use stdout, not file logs.", "importance": 0.6, "tags": ["logging", "k8s"]}
{"key": "redis_eviction", "category": "gotcha", "content": "Redis used as a cache must set maxmemory-policy to an allkeys-* eviction; the default noeviction policy OOMs writes under load.", "importance": 0.7, "tags": ["redis", "ops"]}
{"key": "postgres_backups", "category": "pattern", "content": "Postgres volumes are snapshotted on a daily schedule with 7 daily and 4 weekly retention; restores are drilled quarterly.", "importance": 0.7, "tags": ["postgres", "backup"]}
{"key": "secret_store_sops", "category": "architecture", "content": "Secrets reach workloads via SOPS-decrypted manifests applied by helmfile, not via a runtime secret-store CSI mount.", "importance": 0.7, "tags": ["k8s", "secrets"]}
{"key": "ingress_tls_certmanager", "category": "architecture", "content": "Ingress TLS terminates at the cluster ingress controller with certificates from cert-manager using the cluster-issuer.", "importance": 0.6, "tags": ["k8s", "ingress"]}
{"key": "resource_limits", "category": "convention", "content": "All containers set CPU and memory requests; limits are set where noisy-neighbor risk exists (best-effort QoS is not used for stateful services).", "importance": 0.6, "tags": ["k8s", "resources"]}
{"key": "helm_values_layer", "category": "pattern", "content": "Helm values are layered per environment (values.yaml + values-<env>.yaml + SOPS-encrypted secrets) selected by the helmfile environment.", "importance": 0.7, "tags": ["helm", "config"]}
{"key": "sops_ci_key", "category": "gotcha", "content": "Decrypting SOPS files requires the Age private key matching the recipients in .sops.yaml; CI uses a different key than developer laptops.", "importance": 0.8, "tags": ["sops", "ci"]}
{"key": "docker_compose_local", "category": "convention", "content": "Local multi-service dev stacks are defined in docker-compose files under each service directory, not a monorepo root compose file.", "importance": 0.6, "tags": ["docker", "workflow"]}
{"key": "github_labels_std", "category": "convention", "content": "Issues use the standard label set (bug, enhancement, docs, good first issue); do not invent ad-hoc labels per PR.", "importance": 0.5, "tags": ["github", "issues"]}
{"key": "changelog_keepachangelog", "category": "convention", "content": "CHANGELOG.md follows Keep a Changelog: Added/Changed/Fixed/Removed sections, newest release at top, links to compare ranges.", "importance": 0.6, "tags": ["release", "docs"]}
{"key": "golangci_config", "category": "convention", "content": "Lint runs via golangci-lint with the repo .golangci.yml; fix findings rather than nolint-ing them unless the suppression is justified in a comment.", "importance": 0.7, "tags": ["go", "lint"]}
{"key": "age_key_ci", "category": "gotcha", "content": "CI decrypts SOPS with a keyless age recipient bound to the workflow identity; laptop keys never appear in CI secrets.", "importance": 0.7, "tags": ["sops", "ci"]}
{"key": "config_preview_magic", "category": "dependency", "content": "Preview network magic is 2; Sancho network magic is 4; mixing config directories across networks fails the handshake.", "importance": 0.7, "tags": ["cardano", "networks"]}
{"key": "ouroboros_ntp", "category": "dependency", "content": "cardano-node trusts NTP for slot timing; unsynchronized clocks cause needless peer churn and missed slots.", "importance": 0.5, "tags": ["cardano", "time"]}
{"key": "grafana_ingress_port", "category": "fact", "content": "Grafana on the monitoring host is served on port 80 behind the ingress.", "importance": 0.5, "tags": ["infra", "grafana"]}
{"key": "helmfile_selector_required", "category": "gotcha", "content": "Applying without a release selector can drag unrelated releases into the change set; always scope with -l when the blast radius matters.", "importance": 0.9, "tags": ["helmfile", "safety"]}
{"key": "yaml_two_space", "category": "convention", "content": "YAML files use two-space indentation everywhere; never change the indentation width.", "importance": 0.6, "tags": ["convention", "yaml"]}
{"key": "no_main_direct", "category": "preference", "content": "Never push directly to main; every change goes through a feature branch and a pull request, no matter how small.", "importance": 1.0, "tags": ["workflow", "git"]}
{"key": "sops_never_plain", "category": "preference", "content": "Never commit unencrypted secrets; SOPS-encrypted files only, and verify with git diff before pushing.", "importance": 1.0, "tags": ["secrets", "policy"]}
{"key": "pr_always", "category": "preference", "content": "Open a PR for every change including one-liners; direct pushes to main are blocked by branch protection on this repository.", "importance": 0.9, "tags": ["workflow", "git"]}
{"key": "evidence_or_unknown", "category": "preference", "content": "If unsure whether something exists, verify it; when citing a finding, show evidence — a grep result, a line number, a reference — not a summary of what you think you saw.", "importance": 0.9, "tags": ["process", "quality"]}
{"key": "state_scope_before_edit", "category": "preference", "content": "State the scope before editing: what files you will touch and what you will not touch; one concern per change.", "importance": 0.8, "tags": ["process", "review"]}
{"key": "never_remove_for_add", "category": "preference", "content": "Never remove a feature to add a feature; if capability Y gets in the way of X, the approach is wrong.", "importance": 0.9, "tags": ["process", "quality"]}
{"key": "run_tests_before_after", "category": "preference", "content": "When modifying a function with tests, run those tests before AND after the change.", "importance": 0.9, "tags": ["process", "testing"]}
